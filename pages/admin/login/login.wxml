<view class="login">
  <!-- 暖色环境光，替代原来的彩色渐变背景 -->
  <view class="login__ambient"></view>

  <view class="login__brand">
    <image class="login__logo" src="https://s3.bmp.ovh/imgs/2025/10/24/d5c040730dc7af67.png" mode="aspectFit" />
    <text class="login__name">NFUNEST</text>
    <text class="login__tag">ADMIN CONSOLE</text>
  </view>

  <view class="login__panel">
    <text class="login__eyebrow">SIGN IN</text>
    <text class="login__title">管理员登录</text>

    <view class="login__field">
      <text class="login__label">账号</text>
      <input
        class="login__input"
        placeholder="管理员账号"
        placeholder-class="login__placeholder"
        bindinput="onUsername"
        value="{{username}}"
      />
    </view>

    <view class="login__field">
      <text class="login__label">密码</text>
      <input
        class="login__input"
        password="true"
        placeholder="请输入密码"
        placeholder-class="login__placeholder"
        bindinput="onPassword"
        value="{{password}}"
      />
    </view>

    <button class="login__btn" bindtap="login" loading="{{loading}}">登 录</button>
  </view>
</view>
