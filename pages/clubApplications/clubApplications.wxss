/* ======================== */
/* 报名管理页面样式 */
/* ======================== */

.no-permission-page {
  width: 100vw;
  height: 100vh;
  background: #f8fafc;
}

/* 页面容器 */
.applications-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, 'Open Sans', sans-serif;
  position: relative;
}

/* ======================== */
/* 顶部装饰背景 */
/* ======================== */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background-image: var(--decoration-bg, linear-gradient(135deg, #667eea 0%, #764ba2 100%));
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  overflow: hidden;
}

.header-pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
    radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.08) 0%, transparent 30%);
}

/* ======================== */
/* 自定义导航栏 */
/* ======================== */
.custom-nav {
  position: relative;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-left, .nav-right {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.nav-left:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.3);
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* ======================== */
/* 统计概览卡片 */
/* ======================== */
.stats-card {
  position: relative;
  z-index: 10;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 
    0 10rpx 40rpx rgba(0, 0, 0, 0.08),
    0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.stats-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stats-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.stats-subtitle {
  font-size: 22rpx;
  color: #8b8fa3;
}

.stats-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 175, 189, 0.35);
}

.stats-icon {
  width: 40rpx;
  height: 40rpx;
}

.stats-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 0;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a2e;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent, #e5e7eb, transparent);
}

/* ======================== */
/* 状态筛选 */
/* ======================== */
.filter-section {
  position: relative;
  z-index: 10;
  margin-top: 24rpx;
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.filter-tabs {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 24rpx 8rpx 0;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  background: #ffffff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid transparent;
}

.filter-tab:active {
  transform: scale(0.95);
}

.filter-tab.active {
  color: #ffffff;
  background-image: var(--decoration-bg);
  border-color: transparent;
  box-shadow: 0 6rpx 20rpx rgba(255, 175, 189, 0.4);
}

.tab-text {
  line-height: 1;
}

.tab-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: rgba(0, 0, 0, 0.15);
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.filter-tab.active .tab-count {
  background: rgba(255, 255, 255, 0.25);
}

/* ======================== */
/* 报名列表 */
/* ======================== */
.application-list {
  height: calc(100vh - 420rpx);
  position: relative;
  z-index: 10;
}

.list-content {
  padding: 24rpx 24rpx 40rpx;
}

/* 报名卡片 */
.application-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 
    0 8rpx 30rpx rgba(0, 0, 0, 0.06),
    0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.application-card:active {
  transform: scale(0.98);
  box-shadow: 
    0 4rpx 15rpx rgba(0, 0, 0, 0.08),
    0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

/* 左侧状态指示条 */
.card-status-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #e5e7eb;
}

.card-status-bar.submitted {
  background: linear-gradient(180deg, #fbbf24, #f59e0b);
}

.card-status-bar.viewed {
  background: linear-gradient(180deg, #60a5fa, #3b82f6);
}

.card-status-bar.interviewing {
  background: linear-gradient(180deg, #a78bfa, #8b5cf6);
}

.card-status-bar.accepted {
  background: linear-gradient(180deg, #34d399, #10b981);
}

.card-status-bar.rejected {
  background: linear-gradient(180deg, #f87171, #ef4444);
}

/* 卡片主体 */
.card-body {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx 24rpx 32rpx;
}

/* 头像区域 */
.avatar-section {
  position: relative;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.applicant-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #f3f4f6;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.status-badge {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #ffffff;
  border-radius: 20rpx;
  font-weight: 500;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 信息区域 */
.info-section {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.applicant-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 信息行 - 标签和箭头在同一行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.info-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.tag-emoji {
  font-size: 20rpx;
}

.submit-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
  padding-left: 14rpx;
}

.time-emoji {
  font-size: 20rpx;
}

/* 箭头指示器 */
.arrow-indicator {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 50%;
  margin-left: 16rpx;
}

.arrow-text {
  font-size: 32rpx;
  color: #9ca3af;
  font-weight: 300;
  line-height: 1;
}

/* 快捷联系方式 */
.contact-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 20rpx 32rpx;
  background: linear-gradient(135deg, #fefefe 0%, #f8fafc 100%);
  border-top: 1rpx solid #f3f4f6;
  transition: all 0.2s ease;
}

.contact-bar:active {
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
}

.contact-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

/* 电话图标圆圈容器 - 主题色背景 */
.contact-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-icon {
  width: 20rpx;
  height: 20rpx;
}

.contact-value {
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

/* ======================== */
/* 加载更多 */
/* ======================== */
.load-more {
  padding: 30rpx 0;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #f472b6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.no-more-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #e5e7eb, transparent);
}

.no-more-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* ======================== */
/* 空状态 */
/* ======================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
}
