<view class="container" wx:if="{{showContent}}">
  <view class="masthead" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav">
      <view class="nav__back" hover-class="nav__back--pressed" hover-stay-time="60" bindtap="goBack">
        <view class="nav__arrow"></view>
      </view>
    </view>
    <view class="lead">
      <text class="lead__eyebrow">BADGE ARCHIVE</text>
      <text class="lead__title">羽章管理</text>
      <text class="lead__meta">{{badges.length}} 枚羽章 · 可授予优秀成员</text>
    </view>
  </view>

  <view class="content">
    <view class="filters">
      <picker class="filter" mode="selector" range="{{['全部类型', '成就', '等级', '身份']}}" bindchange="onTypeChange">
        <view class="filter__inner">
          <text class="filter__label">类型</text>
          <text class="filter__value">{{filterType === '' ? '全部' : (filterType === 'achievement' ? '成就' : filterType === 'level' ? '等级' : '身份')}}</text>
          <view class="filter__chevron"></view>
        </view>
      </picker>
      <picker class="filter" mode="selector" range="{{['全部稀有度', '普通', '稀有', '史诗', '传说']}}" bindchange="onRarityChange">
        <view class="filter__inner">
          <text class="filter__label">稀有度</text>
          <text class="filter__value">{{filterRarity === '' ? '全部' : (filterRarity === 'common' ? '普通' : filterRarity === 'rare' ? '稀有' : filterRarity === 'epic' ? '史诗' : '传说')}}</text>
          <view class="filter__chevron"></view>
        </view>
      </picker>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中…</view>

    <view class="cards" wx:else>
      <view class="card" wx:for="{{badges}}" wx:key="id">
        <view class="card__head">
          <image class="card__logo badge__icon" src="{{item.icon || '/images/default-badge.png'}}" mode="aspectFit"></image>
          <view class="card__main">
            <view class="badge__head">
              <text class="card__title badge__name">{{item.name}}</text>
              <text class="tag rarity rarity--{{item.rarity}}">{{item.rarity === 'common' ? '普通' : item.rarity === 'rare' ? '稀有' : item.rarity === 'epic' ? '史诗' : '传说'}}</text>
            </view>
            <text class="card__excerpt">{{item.description}}</text>
            <view class="badge__foot">
              <text class="badge__points">{{item.points}} 积分</text>
              <text class="tag tag--quiet">{{item.type === 'achievement' ? '成就' : item.type === 'level' ? '等级' : '身份'}}</text>
            </view>
          </view>
        </view>
        <view class="card__actions">
          <view class="link-btn link-btn--accent" hover-class="link-btn--pressed" bindtap="showAwardModal" data-id="{{item.id}}">授予羽章</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && badges.length === 0}}">
      <view class="empty__seal"><view class="empty__dash"></view></view>
      <text class="empty__title">暂无羽章</text>
      <text class="empty__desc">调整筛选条件后再试</text>
    </view>
  </view>
</view>

<!-- 授予羽章 -->
<view class="mask" wx:if="{{showAwardModal}}">
  <view class="sheet">
    <view class="sheet__grip"></view>
    <view class="sheet__head">
      <view>
        <text class="sheet__eyebrow">AWARD</text>
        <text class="sheet__title">授予羽章</text>
      </view>
      <view class="sheet__close" bindtap="closeAwardModal"><view class="sheet__close-x"></view></view>
    </view>

    <scroll-view class="sheet__body" scroll-y>
      <view class="selected-badge" wx:if="{{selectedBadge}}">
        <image class="selected-badge__icon" src="{{selectedBadge.icon || '/images/default-badge.png'}}" mode="aspectFit"></image>
        <view class="selected-badge__main">
          <text class="selected-badge__name">{{selectedBadge.name}}</text>
          <text class="selected-badge__desc">{{selectedBadge.description}}</text>
        </view>
      </view>

      <view class="form__group">
        <text class="form__label">搜索用户（学号）</text>
        <input class="form__input" placeholder="请输入学号搜索用户" placeholder-class="form__placeholder" bindinput="onStudentIdInput" value="{{searchStudentId}}" />
        <view class="search-results" wx:if="{{showSearchResults}}">
          <view class="person" wx:for="{{searchResults}}" wx:key="id" bindtap="selectUser" data-index="{{index}}">
            <image class="person__avatar" src="{{item.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="person__main">
              <text class="person__name">{{item.nickname}}</text>
              <text class="person__meta">学号 {{item.student_id}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="selected" wx:if="{{selectedUser}}">
        <view class="person">
          <image class="person__avatar" src="{{selectedUser.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="person__main">
            <text class="person__name">{{selectedUser.nickname}}</text>
            <text class="person__meta">学号 {{selectedUser.student_id}}</text>
          </view>
        </view>
        <view class="link-btn link-btn--danger" bindtap="clearUserSelection">清除</view>
      </view>
    </scroll-view>

    <view class="sheet__footer">
      <view class="btn btn--ghost" bindtap="closeAwardModal">取消</view>
      <view class="btn btn--solid {{!selectedUser || awarding ? 'btn--disabled' : ''}}" bindtap="awardBadge">{{awarding ? '授予中…' : '确认授予'}}</view>
    </view>
  </view>
</view>
