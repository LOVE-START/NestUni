<view class="container" wx:if="{{showContent}}">
  <view class="masthead" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav">
      <view class="nav__back" hover-class="nav__back--pressed" hover-stay-time="60" bindtap="goBack">
        <view class="nav__arrow"></view>
      </view>
    </view>
    <view class="lead">
      <text class="lead__eyebrow">CLUB DIRECTORY</text>
      <text class="lead__title">社团管理</text>
      <text class="lead__meta">{{clubPagination.total}} 个社团 · 第 {{clubPagination.page}} / {{clubPagination.totalPages || 1}} 页</text>
    </view>
  </view>

  <view class="content">
    <view class="toolbar">
      <view class="search">
        <view class="search__glyph"></view>
        <input class="search__input" placeholder="搜索社团" placeholder-class="search__placeholder" bindinput="onClubSearch" value="{{clubSearch}}" />
      </view>
      <view class="btn btn--solid btn--compact" hover-class="btn--pressed" bindtap="showAddClubModal">社团</view>
    </view>

    <view class="cards">
      <view class="card" wx:for="{{clubs}}" wx:key="id">
        <view class="card__head">
          <image class="card__logo" wx:if="{{item.logo}}" src="{{item.logo}}" mode="aspectFill"></image>
          <view class="glyph" wx:else>社</view>
          <view class="card__main">
            <text class="card__title">{{item.name}}</text>
            <text class="card__meta">{{item.category || '未分类'}} · {{item.level === 'school' ? '校级' : '学院级'}}</text>
            <text class="card__meta" wx:if="{{item.short_intro}}">{{item.short_intro}}</text>
          </view>
        </view>
        <view class="card__actions">
          <view class="link-btn" hover-class="link-btn--pressed" bindtap="viewClubDetail" data-id="{{item.id}}">详情</view>
          <view class="link-btn" hover-class="link-btn--pressed" bindtap="editClub" data-id="{{item.id}}">编辑</view>
          <view class="link-btn link-btn--danger" hover-class="link-btn--pressed" bindtap="deleteClub" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{clubs.length === 0}}">
      <view class="empty__seal"><view class="empty__dash"></view></view>
      <text class="empty__title">暂无社团</text>
      <text class="empty__desc">调整搜索关键词，或新增第一个社团</text>
    </view>

    <view class="pager" wx:if="{{clubPagination.totalPages > 1}}">
      <view class="pager__btn {{clubPagination.page <= 1 ? 'pager__btn--disabled' : ''}}" bindtap="prevClubPage">上一页</view>
      <text class="pager__info">{{clubPagination.page}} / {{clubPagination.totalPages}}</text>
      <view class="pager__btn {{clubPagination.page >= clubPagination.totalPages ? 'pager__btn--disabled' : ''}}" bindtap="nextClubPage">下一页</view>
    </view>
  </view>
</view>

<!-- 添加 / 编辑社团 -->
<view class="mask" wx:if="{{showAddClubModal}}">
  <view class="sheet">
    <view class="sheet__grip"></view>
    <view class="sheet__head">
      <view>
        <text class="sheet__eyebrow">CLUB EDITOR</text>
        <text class="sheet__title">{{editClubId ? '编辑社团' : '新增社团'}}</text>
      </view>
      <view class="sheet__close" bindtap="closeAddClubModal"><view class="sheet__close-x"></view></view>
    </view>

    <scroll-view class="sheet__body" scroll-y>
      <view class="form__group">
        <text class="form__label">社团名称</text>
        <input class="form__input" placeholder="请输入社团名称" placeholder-class="form__placeholder" data-field="name" bindinput="onClubFormChange" value="{{clubForm.name}}" />
      </view>

      <view class="form__group">
        <text class="form__label">分类</text>
        <picker mode="selector" range="{{categories}}" value="{{selectedCategoryIndex}}" bindchange="onCategoryChange">
          <view class="form__value {{clubForm.category ? '' : 'form__value--empty'}}">
            <text>{{clubForm.category || '请选择分类'}}</text>
            <view class="form__chevron"></view>
          </view>
        </picker>
      </view>

      <view class="form__group">
        <text class="form__label">社团级别</text>
        <picker range="{{['学院级', '校级']}}" bindchange="onLevelChange" value="{{clubForm.level === 'school' ? 1 : 0}}">
          <view class="form__value">
            <text>{{clubForm.level === 'school' ? '校级' : '学院级'}}</text>
            <view class="form__chevron"></view>
          </view>
        </picker>
      </view>

      <view class="form__group">
        <text class="form__label">简介</text>
        <input class="form__input" placeholder="一句话介绍社团" placeholder-class="form__placeholder" data-field="short_intro" bindinput="onClubFormChange" value="{{clubForm.short_intro}}" />
      </view>

      <view class="form__group">
        <text class="form__label">详细描述</text>
        <textarea class="form__textarea" placeholder="请输入详细描述" placeholder-class="form__placeholder" data-field="description" bindinput="onClubFormChange" value="{{clubForm.description}}" />
      </view>

      <view class="form__group">
        <text class="form__label">LOGO</text>
        <view class="uploader">
          <view class="uploader__item" wx:if="{{clubForm.logo}}" bindtap="previewFormImage" data-url="{{clubForm.logo}}" data-field="logo">
            <image class="uploader__img" src="{{clubForm.logo}}" mode="aspectFit"></image>
            <view class="uploader__remove" catchtap="deleteLogo">×</view>
          </view>
          <view class="uploader__add" wx:else bindtap="selectLogo">选择 LOGO</view>
        </view>
      </view>

      <view class="form__group">
        <text class="form__label">封面图片</text>
        <view class="uploader">
          <view class="uploader__item" wx:if="{{clubForm.cover_image}}" bindtap="previewFormImage" data-url="{{clubForm.cover_image}}" data-field="cover_image">
            <image class="uploader__img" src="{{clubForm.cover_image}}" mode="aspectFit"></image>
            <view class="uploader__remove" catchtap="deleteCoverImage">×</view>
          </view>
          <view class="uploader__add" wx:else bindtap="selectCoverImage">选择封面</view>
        </view>
      </view>

      <view class="form__group">
        <text class="form__label">社团相册</text>
        <view class="uploader">
          <block wx:for="{{clubForm.gallery}}" wx:key="index">
            <view class="uploader__item" wx:if="{{item}}">
              <image class="uploader__img" src="{{item}}" mode="aspectFit" bindtap="previewFormImage" data-url="{{item}}" data-field="gallery"></image>
              <view class="uploader__remove" catchtap="deleteGalleryImage" data-index="{{index}}">×</view>
            </view>
            <view class="uploader__add" wx:else bindtap="selectGalleryImage" data-index="{{index}}">选择图片</view>
          </block>
          <view class="uploader__add" bindtap="addGallerySlot">添加图片</view>
        </view>
      </view>
    </scroll-view>

    <view class="sheet__footer">
      <view class="btn btn--ghost" bindtap="closeAddClubModal">取消</view>
      <view class="btn btn--solid" bindtap="saveClub">保存</view>
    </view>
  </view>
</view>

<!-- 社团详情 -->
<view class="mask" wx:if="{{showClubDetailModal}}">
  <view class="sheet">
    <view class="sheet__grip"></view>
    <view class="sheet__head">
      <view>
        <text class="sheet__eyebrow">CLUB PROFILE</text>
        <text class="sheet__title">社团详情</text>
      </view>
      <view class="sheet__close" bindtap="closeClubDetailModal"><view class="sheet__close-x"></view></view>
    </view>

    <scroll-view class="sheet__body detail-body" scroll-y>
      <text class="detail__title">{{currentClub.name}}</text>

      <view class="drows">
        <view class="drow">
          <text class="drow__key">分类</text>
          <text class="drow__val">{{currentClub.category || '未分类'}}</text>
        </view>
        <view class="drow">
          <text class="drow__key">级别</text>
          <text class="drow__val">{{currentClub.level === 'school' ? '校级' : '学院级'}}</text>
        </view>
        <view class="drow">
          <text class="drow__key">简介</text>
          <text class="drow__val {{currentClub.short_intro ? '' : 'drow__val--empty'}}">{{currentClub.short_intro || '未填写'}}</text>
        </view>
      </view>

      <text class="detail__label">DESCRIPTION</text>
      <text class="detail__text">{{currentClub.description || '暂无详细描述'}}</text>

      <view wx:if="{{currentClub.logo || currentClub.cover_image}}">
        <text class="detail__label">MEDIA</text>
        <view class="uploader">
          <view class="uploader__item" wx:if="{{currentClub.logo}}" bindtap="previewImage" data-url="{{currentClub.logo}}">
            <image class="uploader__img" src="{{currentClub.logo}}" mode="aspectFit"></image>
          </view>
          <view class="uploader__item" wx:if="{{currentClub.cover_image}}" bindtap="previewImage" data-url="{{currentClub.cover_image}}">
            <image class="uploader__img" src="{{currentClub.cover_image}}" mode="aspectFill"></image>
          </view>
        </view>
      </view>

      <view wx:if="{{currentClub.gallery && currentClub.gallery.length > 0}}">
        <text class="detail__label">GALLERY</text>
        <view class="uploader">
          <view class="uploader__item" wx:for="{{currentClub.gallery}}" wx:key="index" bindtap="previewImage" data-url="{{item}}">
            <image class="uploader__img" src="{{item}}" mode="aspectFill"></image>
          </view>
        </view>
      </view>

      <view class="section-head">
        <text class="section-head__title">MEMBERS · {{clubMembers.length}}</text>
        <view class="mini-action" hover-class="mini-action--pressed" bindtap="showAddMemberModal">添加成员</view>
      </view>
      <view class="person" wx:for="{{clubMembers}}" wx:key="user_id">
        <image class="person__avatar" src="{{item.avatar_url || '../../assets/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="person__main">
          <text class="person__name">{{item.nickname}}</text>
          <text class="person__meta">学号 {{item.student_id}} · {{item.role === 'leader' ? '团长' : '成员'}}</text>
        </view>
        <view class="person__actions">
          <view class="link-btn" hover-class="link-btn--pressed" bindtap="changeMemberRole" data-user-id="{{item.user_id}}" data-current-role="{{item.role}}">角色</view>
          <view class="link-btn link-btn--danger" hover-class="link-btn--pressed" bindtap="removeMember" data-user-id="{{item.user_id}}">移除</view>
        </view>
      </view>
      <text class="empty__desc" wx:if="{{clubMembers.length === 0}}">暂无成员</text>

      <view class="section-head">
        <text class="section-head__title">ANNOUNCEMENTS</text>
        <view class="mini-action" hover-class="mini-action--pressed" bindtap="showAddClubAnnouncementModal">发布公告</view>
      </view>
      <view class="announce-row" wx:for="{{clubAnnouncements}}" wx:key="id">
        <text class="announce-row__title">{{item.title}}</text>
        <view class="announce-row__actions">
          <view class="link-btn" hover-class="link-btn--pressed" bindtap="editClubAnnouncement" data-id="{{item.id}}">编辑</view>
          <view class="link-btn link-btn--danger" hover-class="link-btn--pressed" bindtap="deleteClubAnnouncement" data-id="{{item.id}}">删除</view>
        </view>
      </view>
      <text class="empty__desc" wx:if="{{clubAnnouncements.length === 0}}">暂无公告</text>
    </scroll-view>
  </view>
</view>

<!-- 添加成员 -->
<view class="mask" wx:if="{{showAddMemberModal}}">
  <view class="sheet">
    <view class="sheet__grip"></view>
    <view class="sheet__head">
      <view>
        <text class="sheet__eyebrow">NEW MEMBER</text>
        <text class="sheet__title">添加成员</text>
      </view>
      <view class="sheet__close" bindtap="closeAddMemberModal"><view class="sheet__close-x"></view></view>
    </view>

    <scroll-view class="sheet__body" scroll-y>
      <view class="form__group">
        <text class="form__label">学号搜索</text>
        <input class="form__input" placeholder="请输入学号检索用户" placeholder-class="form__placeholder" bindinput="onStudentIdInput" value="{{searchStudentId}}" />
        <view class="search-results" wx:if="{{showSearchResults}}">
          <view class="person" wx:for="{{searchResults}}" wx:key="id" bindtap="selectUser" data-index="{{index}}">
            <image class="person__avatar" src="{{item.avatar || '../../images/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="person__main">
              <text class="person__name">{{item.nickname}}</text>
              <text class="person__meta">学号 {{item.student_id}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="selected" wx:if="{{selectedUser}}">
        <view class="person">
          <image class="person__avatar" src="{{selectedUser.avatar || '../../images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="person__main">
            <text class="person__name">{{selectedUser.nickname}}</text>
            <text class="person__meta">学号 {{selectedUser.student_id}}</text>
          </view>
        </view>
        <view class="link-btn link-btn--danger" bindtap="clearUserSelection">清除</view>
      </view>

      <view class="form__group">
        <text class="form__label">角色</text>
        <picker range="{{['成员', '团长']}}" bindchange="onMemberRoleChange" value="{{memberForm.role === 'leader' ? 1 : 0}}">
          <view class="form__value">
            <text>{{memberForm.role === 'leader' ? '团长' : '成员'}}</text>
            <view class="form__chevron"></view>
          </view>
        </picker>
      </view>
    </scroll-view>

    <view class="sheet__footer">
      <view class="btn btn--ghost" bindtap="closeAddMemberModal">取消</view>
      <view class="btn btn--solid" bindtap="addMember">添加</view>
    </view>
  </view>
</view>

<!-- 发布 / 编辑社团公告 -->
<view class="mask" wx:if="{{showAddClubAnnouncementModal}}">
  <view class="sheet">
    <view class="sheet__grip"></view>
    <view class="sheet__head">
      <view>
        <text class="sheet__eyebrow">ANNOUNCEMENT</text>
        <text class="sheet__title">{{editClubAnnouncementId ? '编辑公告' : '发布公告'}}</text>
      </view>
      <view class="sheet__close" bindtap="closeAddClubAnnouncementModal"><view class="sheet__close-x"></view></view>
    </view>

    <scroll-view class="sheet__body" scroll-y>
      <view class="form__group">
        <text class="form__label">标题</text>
        <input class="form__input" placeholder="请输入公告标题" placeholder-class="form__placeholder" data-field="title" bindinput="onClubAnnouncementFormChange" value="{{clubAnnouncementForm.title}}" />
      </view>
      <view class="form__group">
        <text class="form__label">内容</text>
        <textarea class="form__textarea" placeholder="请输入公告内容" placeholder-class="form__placeholder" data-field="content" bindinput="onClubAnnouncementFormChange" value="{{clubAnnouncementForm.content}}" />
      </view>
    </scroll-view>

    <view class="sheet__footer">
      <view class="btn btn--ghost" bindtap="closeAddClubAnnouncementModal">取消</view>
      <view class="btn btn--solid" bindtap="saveClubAnnouncement">保存</view>
    </view>
  </view>
</view>
