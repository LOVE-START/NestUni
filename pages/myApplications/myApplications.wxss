/* ======================== */
/* 我的报名页面 - 简洁现代风格 */
/* ======================== */

/* 页面容器 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, 'Open Sans', sans-serif;
  position: relative;
}

/* ======================== */
/* 顶部装饰背景 */
/* ======================== */
.header-decoration {
  position: relative;
  background-image: var(--decoration-bg, linear-gradient(135deg, #ffbfc9 0%, #ffc3a0 100%));
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  overflow: hidden;
  padding-bottom: 32rpx;
}

.header-pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
    radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.08) 0%, transparent 30%);
}

/* ======================== */
/* 自定义导航栏 */
/* ======================== */
.custom-nav {
  position: relative;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-left, .nav-right {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.nav-left:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.3);
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* ======================== */
/* 统计数据 - 内联显示在背景上 */
/* ======================== */
.stats-inline {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  margin-top: 8rpx;
}

.stats-inline__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-inline__num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.stats-inline__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 400;
}

.stats-inline__divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* ======================== */
/* 状态筛选 - 简约线条风格 */
/* ======================== */
.filter-section {
  position: relative;
  z-index: 10;
  padding: 20rpx 0 0;
  margin-top: 12rpx;
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
  /* 整体右移，因为移除了"已拒绝"tab */
  margin-left: 30rpx;
}

.filter-list {
  display: inline-flex;
  align-items: center;
  padding-right: 32rpx;
}

.filter-tab {
  position: relative;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #9ca3af;
  font-weight: 400;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.filter-tab:active {
  opacity: 0.7;
}

.filter-divider {
  width: 1rpx;
  height: 24rpx;
  background: #e5e7eb;
  flex-shrink: 0;
}

.filter-underline {
  margin: 12rpx 32rpx 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #e5e7eb 20%, #e5e7eb 80%, transparent);
}

/* 激活状态 - 主题色文字 + 底部线条 */
.filter-tab--active {
  color: var(--theme-primary, #ffafb9);
  font-weight: 600;
}

.filter-tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-image: var(--decoration-bg, linear-gradient(135deg, #ffbfc9 0%, #ffc3a0 100%));
}

/* ======================== */
/* 列表区域 */
/* ======================== */
.list-section {
  position: relative;
  z-index: 10;
  height: calc(100vh - 300rpx);
}

.list-container {
  padding: 24rpx 24rpx 0;
}

/* ======================== */
/* 报名卡片 */
/* ======================== */
.app-card {
  background: #ffffff;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 
    0 8rpx 30rpx rgba(0, 0, 0, 0.06),
    0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s ease;
}

.app-card:active {
  transform: scale(0.98);
}

/* 卡片头部 */
.app-card__header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.app-card__cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.app-card__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.app-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.app-card__club {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.app-card__avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 2rpx solid #f3f4f6;
}

.app-card__club-name {
  font-size: 24rpx;
  color: #6b7280;
}

/* 状态标签 - 统一使用主题色 */
.app-card__status {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background-image: var(--decoration-bg, linear-gradient(135deg, #ffbfc9 0%, #ffc3a0 100%));
  display: flex;
  align-items: center;
  justify-content: center;
}

.app-card__status-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
}

/* 卡片底部 */
.app-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.app-card__time {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.app-card__time-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

.app-card__time-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 面试信息 - 使用主题色 */
.app-card__interview {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  background-image: var(--decoration-bg, linear-gradient(135deg, #ffbfc9 0%, #ffc3a0 100%));
  border-radius: 20rpx;
}

.app-card__interview-icon {
  width: 24rpx;
  height: 24rpx;
}

.app-card__interview-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

/* ======================== */
/* 加载状态 */
/* ======================== */
.load-state {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}

.loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--theme-primary, #ffbfc9);
  border-radius: 50%;
  animation: loadingPulse 1.2s ease-in-out infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes loadingPulse {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.2);
    opacity: 1;
  }
}

.no-more {
  padding: 20rpx 0;
}

.no-more__text {
  font-size: 24rpx;
  color: #bfbfbf;
}

/* ======================== */
/* 空状态 */
/* ======================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 175, 189, 0.35);
  background-image: var(--decoration-bg, linear-gradient(135deg, #ffbfc9 0%, #ffc3a0 100%));
}

.empty-icon {
  width: 60rpx;
  height: 60rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8b8fa3;
  margin-bottom: 40rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 56rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 175, 189, 0.3);
  transition: all 0.3s ease;
  background-image: var(--decoration-bg, linear-gradient(135deg, #ffbfc9 0%, #ffc3a0 100%));
}

.empty-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(255, 175, 189, 0.3);
}

.empty-btn__text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ======================== */
/* 底部安全区 */
/* ======================== */
.safe-bottom {
  height: 100rpx;
}

@supports (padding-bottom: env(safe-area-inset-bottom)) {
  .safe-bottom {
    height: calc(100rpx + env(safe-area-inset-bottom));
  }
}
