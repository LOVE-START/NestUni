/* 我的审核记录页面样式 */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* ========== 标签切换 ========== */

.tabs {
  display: flex;
  background: white;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #64748b;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #667eea;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* ========== 审核记录列表 ========== */

.approval-list {
  padding: 0 30rpx;
}

.approval-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #94a3b8;
}

.approval-card.pending {
  border-left-color: #f59e0b;
}

.approval-card.approved {
  border-left-color: #22c55e;
}

.approval-card.rejected {
  border-left-color: #ef4444;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border-bottom: 1rpx solid #e2e8f0;
}

.type-tag {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.type-tag.event {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #b45309;
}

.type-tag.announcement {
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  color: #1d4ed8;
}

.type-tag.club {
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
  color: #15803d;
}

.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.pending {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #b45309;
}

.status-tag.approved {
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
  color: #15803d;
}

.status-tag.rejected {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
  color: #b91c1c;
}

.card-content {
  padding: 24rpx;
}

.title-row {
  margin-bottom: 16rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.info-row .label {
  color: #64748b;
  min-width: 140rpx;
  flex-shrink: 0;
}

.info-row .value {
  color: #334155;
  flex: 1;
}

.reject-reason {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #fef2f2;
  border-radius: 12rpx;
}

.reject-reason .label {
  color: #dc2626;
}

.reject-reason .value {
  color: #991b1b;
}

/* ========== 空状态 ========== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background: white;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}

/* ========== 加载状态 ========== */

.loading-state {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #94a3b8;
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 30rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #94a3b8;
}
