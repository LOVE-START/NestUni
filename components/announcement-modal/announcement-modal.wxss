/* ========================================
   公告弹窗组件样式
   设计风格：与首页 kawaii 风格统一
   - 贴纸式白卡（3rpx 浅描边 + 白色描边光晕 + 柔和蓝投影）
   - 顶部主题色"胶带"标签、菱形虚线分隔、纯文字正文
   - 40rpx 以上大圆角、主题渐变胶囊按钮
   ======================================== */

/* ========================================
   弹窗容器 - 全屏居中
   ======================================== */
.announcement-modal {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 9999;
	display: flex;
	align-items: center;
	justify-content: center;
	opacity: 0;
	transition: opacity 0.28s ease;
}

.announcement-modal.show {
	opacity: 1;
}

/* 卡片背后的柔光：让卡片像悬浮在遮罩上，增加空气感 */
.announcement-modal::before {
	content: "";
	position: absolute;
	top: 50%;
	left: 50%;
	width: 780rpx;
	height: 780rpx;
	transform: translate(-50%, -50%);
	background: radial-gradient(
		circle,
		rgba(255, 255, 255, 0.18) 0%,
		rgba(255, 255, 255, 0.06) 44%,
		transparent 70%
	);
	pointer-events: none;
	z-index: 1;
}

/* ========================================
   遮罩层 - 浅色柔化背景，与首页轻盈感一致
   ======================================== */
.modal-mask {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: radial-gradient(
		120% 95% at 50% 42%,
		rgba(47, 51, 72, 0.34) 0%,
		rgba(47, 51, 72, 0.5) 100%
	);
	backdrop-filter: blur(12rpx);
	-webkit-backdrop-filter: blur(12rpx);
	z-index: 0;
}

/* ========================================
   卡片外壳 - 承载胶带贴纸与入场动画
   ======================================== */
.card-shell {
	position: relative;
	z-index: 2;
	width: 640rpx;
	animation: cardPopIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* 入场动画：轻微回弹 + 微旋转，和首页卡片的活泼调性呼应 */
@keyframes cardPopIn {
	0% {
		transform: scale(0.86) translateY(40rpx) rotate(-1.5deg);
		opacity: 0;
	}
	100% {
		transform: scale(1) translateY(0) rotate(0deg);
		opacity: 1;
	}
}

/* ========================================
   顶部胶带标签 - 主题色柔化 + 斜纹胶带质感
   ======================================== */
.card-tape {
	position: absolute;
	top: -30rpx;
	left: 50%;
	z-index: 3;
	display: flex;
	align-items: center;
	gap: 10rpx;
	padding: 12rpx 34rpx;
	border-radius: 999rpx;
	/* 用白色半透明层把主题渐变"冲淡"成柔和的马卡龙色，深色文字也能保持可读 */
	background-image:
		repeating-linear-gradient(
			115deg,
			rgba(255, 255, 255, 0.34) 0,
			rgba(255, 255, 255, 0.34) 6rpx,
			rgba(255, 255, 255, 0) 6rpx,
			rgba(255, 255, 255, 0) 20rpx
		),
		linear-gradient(rgba(255, 255, 255, 0.66), rgba(255, 255, 255, 0.66)),
		var(--announce-gradient, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
	box-shadow:
		0 10rpx 22rpx rgba(150, 170, 215, 0.28),
		inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
	transform: translateX(-50%) rotate(-2.5deg);
}

/* 胶带上的小圆点：深灰紫，弱化后不抢文字焦点 */
.tape-dot {
	width: 8rpx;
	height: 8rpx;
	border-radius: 50%;
	background: rgba(96, 92, 108, 0.55);
}

.tape-text {
	font-size: 22rpx;
	font-weight: 800;
	line-height: 1;
	color: #625c6e;
	letter-spacing: 5rpx;
}

/* ========================================
   公告卡片主体 - 复用首页卡片视觉语言
   ======================================== */
.announce-card {
	position: relative;
	width: 100%;
	max-height: 88vh;
	padding: 0;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	/* 多层柔和光斑代替纯白底，让卡片拥有纸张般的温度 */
	background-image:
		radial-gradient(circle at 16% 6%, rgba(168, 192, 255, 0.14) 0%, transparent 44%),
		radial-gradient(circle at 88% 98%, rgba(255, 196, 210, 0.16) 0%, transparent 48%),
		linear-gradient(160deg, #ffffff 0%, #fcfcff 100%);
	border: 3rpx solid #eef0f6;
	border-radius: 44rpx;
	/* 第一层白色描边光晕模拟贴纸模切边，后两层是柔和投影 */
	box-shadow:
		0 0 0 12rpx rgba(255, 255, 255, 0.32),
		0 28rpx 70rpx rgba(126, 150, 205, 0.3),
		0 10rpx 24rpx rgba(0, 0, 0, 0.05);
	overflow: hidden;
}

/* ========================================
   标题区域
   ======================================== */
.card-header {
	padding: 66rpx 56rpx 30rpx;
	text-align: center;
	box-sizing: border-box;
}

/* 标题行：两侧爱心与标题在同一行居中对齐 */
.title-row {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 14rpx;
}

/* 主题色爱心：用主题渐变填充文字，纯静态不做动效 */
.title-heart {
	flex-shrink: 0;
	font-size: 38rpx;
	line-height: 1;
	/* 兜底色：若背景裁剪不被支持，爱心仍有可见颜色 */
	color: #bdbdc9;
	background-image: var(--announce-gradient, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
	-webkit-background-clip: text;
	background-clip: text;
	-webkit-text-fill-color: transparent;
	/* 淡投影提升浅色主题（如蓝色）下爱心的辨识度 */
	text-shadow: 0 2rpx 6rpx rgba(150, 170, 215, 0.2);
}

.card-title {
	display: block;
	font-family: "Comic Sans MS", "幼圆", cursive;
	font-size: 42rpx;
	font-weight: 800;
	line-height: 1.4;
	color: #5c5c6b;
	letter-spacing: 2rpx;
}

/* 标题与正文之间的细虚线，中间嵌一枚小菱形 */
.header-divider {
	position: relative;
	height: 2rpx;
	margin: 0 56rpx;
	background-image: linear-gradient(
		to right,
		#e8ebf3 0,
		#e8ebf3 12rpx,
		transparent 12rpx,
		transparent 24rpx
	);
	background-size: 24rpx 2rpx;
	background-repeat: repeat-x;
}

.header-divider::after {
	content: "";
	position: absolute;
	top: 50%;
	left: 50%;
	width: 12rpx;
	height: 12rpx;
	border-radius: 4rpx;
	background-image: var(--announce-gradient, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
	box-shadow: 0 0 0 6rpx #ffffff;
	transform: translate(-50%, -50%) rotate(45deg);
}

/* ========================================
   内容滚动区域
   ======================================== */
.card-body {
	flex: 1;
	min-height: 0;
	max-height: 700rpx;
	padding: 28rpx 40rpx 16rpx;
	box-sizing: border-box;
}

/* 公告文字容器 - 左右留出与图片白框相同的内缩量（12rpx 内边距 + 2rpx 边框），保证文字与图片边缘对齐 */
.content-text-wrapper {
	width: 100%;
	padding: 0 14rpx;
	margin-bottom: 24rpx;
	box-sizing: border-box;
}

.content-text {
	font-size: 29rpx;
	line-height: 1.9;
	color: #5d5d6b;
	word-break: break-all;
	white-space: pre-wrap;
	letter-spacing: 0.5rpx;
}

/* 公告图片容器 - 拍立得白框，底部留白略宽 */
.content-image-wrapper {
	position: relative;
	width: 100%;
	padding: 12rpx 12rpx 20rpx;
	box-sizing: border-box;
	margin-bottom: 8rpx;
	background: #ffffff;
	border: 2rpx solid #eff2f8;
	border-radius: 28rpx;
	overflow: hidden;
	box-shadow: 0 12rpx 28rpx rgba(150, 170, 215, 0.18);
}

.content-image {
	width: 100%;
	display: block;
	border-radius: 18rpx;
}

/* 空内容状态 */
.content-empty {
	padding: 80rpx 0;
	text-align: center;
}

.content-empty__text {
	font-size: 28rpx;
	color: #a2a2b0;
	letter-spacing: 1rpx;
}

/* ========================================
   底部操作区
   ======================================== */
.card-footer {
	padding: 24rpx 48rpx 46rpx;
	box-sizing: border-box;
}

/* 确认按钮 - 沿用首页主题渐变与胶囊圆角 */
.confirm-btn {
	position: relative;
	width: 100%;
	height: 100rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 16rpx;
	padding: 0;
	margin: 0;
	border: none;
	border-radius: 50rpx;
	background-image: var(--announce-gradient, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
	box-shadow:
		0 14rpx 30rpx rgba(150, 170, 215, 0.35),
		0 4rpx 10rpx rgba(150, 170, 215, 0.2),
		inset 0 2rpx 4rpx rgba(255, 255, 255, 0.55);
	transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
}

/* 移除小程序 button 默认边框 */
.confirm-btn::after {
	border: none;
}

.btn-text {
	font-size: 32rpx;
	font-weight: 800;
	line-height: 1;
	color: #ffffff;
	letter-spacing: 2rpx;
	text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

/* 按压反馈 */
.confirm-btn:active:not(.disabled) {
	transform: scale(0.97);
	box-shadow:
		0 6rpx 16rpx rgba(150, 170, 215, 0.3),
		inset 0 2rpx 4rpx rgba(255, 255, 255, 0.55);
}

/* 倒计时禁用态：主题色柔化成马卡龙底，比纯灰更有整体感 */
.confirm-btn.disabled {
	background-image:
		linear-gradient(rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.76)),
		var(--announce-gradient, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
	box-shadow:
		inset 0 0 0 2rpx rgba(255, 255, 255, 0.9),
		inset 0 2rpx 6rpx rgba(150, 170, 215, 0.1);
	opacity: 1;
}

.confirm-btn.disabled .btn-text {
	color: #85808f;
	text-shadow: none;
	font-weight: 700;
}

/* ========================================
   倒计时进度环
   ======================================== */
.countdown-ring {
	position: relative;
	width: 46rpx;
	height: 46rpx;
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
}

/* 进度环底槽：与柔化的按钮底色协调的低饱和灰蓝 */
.ring-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	border-radius: 50%;
	background: rgba(133, 139, 158, 0.16);
}

/* 进度环：灰蓝描边，保证在马卡龙底色上依然清晰 */
.ring-progress {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	border-radius: 50%;
	background: conic-gradient(
		#8f93a6 0deg,
		#8f93a6 var(--progress, 0deg),
		transparent var(--progress, 0deg),
		transparent 360deg
	);
	-webkit-mask: radial-gradient(circle, transparent 62%, #000 62%);
	mask: radial-gradient(circle, transparent 62%, #000 62%);
}

.countdown-number {
	position: relative;
	font-size: 24rpx;
	font-weight: 800;
	color: #6f7280;
	line-height: 1;
}
