/* 登录弹窗主容器 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

/* 遮罩层 - 半透明背景 */
.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 1001;
}

/* 弹窗容器 - 现代化卡片设计 */
.modal-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  padding: 0;
  background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 32rpx;
  box-shadow: 
    0 20rpx 60rpx rgba(18, 32, 56, 0.25),
    0 8rpx 24rpx rgba(0, 0, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  z-index: 1002;
  overflow: hidden;
}

/* 弹窗头部 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 24rpx;
}

.modal-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 50%;
  transition: all 0.3s ease;
}

.close-icon {
  font-size: 28rpx;
  color: #666;
  line-height: 1;
}

.close-btn:active {
  background: rgba(0, 0, 0, 0.08);
  transform: scale(0.9);
}

/* 弹窗主体 */
.modal-body {
  padding: 0 40rpx;
}

/* 头像和昵称区域 */
.avatar-nickname-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 30rpx;
}

/* 头像上传容器 */
.avatar-upload-container {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
}

/* 头像外圈装饰环 */
.avatar-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  z-index: 0;
  animation: ring-pulse 2s ease-in-out infinite;
}

@keyframes ring-pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.05);
    opacity: 1;
  }
}

.avatar-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 100%);
  border: 4rpx solid #fff;
  overflow: hidden;
  z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

/* 头像遮罩 - 半透明渐变 */
.avatar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.6) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 16rpx;
  z-index: 2;
  border-radius: 50%;
}

.overlay-text {
  color: #fff;
  font-size: 18rpx;
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

/* 头像选择中状态遮罩 */
.avatar-loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(18, 32, 56, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  border-radius: 50%;
}

/* 加载动画 */
.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 头像按钮禁用状态 */
.avatar-wrapper.disabled {
  opacity: 0.7;
  pointer-events: none;
}

/* 输入组样式 */
.input-group {
  margin: 16rpx 0;
}

.nickname-group {
  width: 100%;
}

.input-label-container {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.optional-tag {
  font-size: 22rpx;
  color: #ff9eb5;
  background: rgba(255, 175, 189, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

/* 输入框容器 */
.input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-wrapper:focus-within {
  background: #fff;
  border-color: #999;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 100%;
}

.input-field::placeholder {
  color: #aaa;
}

.nickname-input {
  width: 100%;
}

/* 弹窗底部 */
.modal-footer {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 40rpx 40rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.cancel-btn {
  background: #f0f2f5;
  color: #666;
}

.cancel-btn:active {
  background: #e4e6e9;
  transform: scale(0.98);
}

.confirm-btn {
  color: #fff;
}

.confirm-btn:active {
  transform: scale(0.98);
}

/* 按钮点击波纹效果 */
.btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.3s, height 0.3s;
}

.btn:active::after {
  width: 200%;
  height: 200%;
}
