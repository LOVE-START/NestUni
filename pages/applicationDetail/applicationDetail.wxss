/* ======================== */
/* 报名详情页面样式 */
/* ======================== */

.no-permission-page {
  width: 100vw;
  height: 100vh;
  background: #f8fafc;
}

/* 页面容器 */
.detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, 'Open Sans', sans-serif;
  position: relative;
}

/* ======================== */
/* 顶部装饰背景 */
/* ======================== */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background-image: var(--decoration-bg, linear-gradient(135deg, #667eea 0%, #764ba2 100%));
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  overflow: hidden;
}

.header-pattern {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
    radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.08) 0%, transparent 30%);
}

/* ======================== */
/* 自定义导航栏 */
/* ======================== */
.custom-nav {
  position: relative;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-left, .nav-right {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.nav-left:active {
  transform: scale(0.9);
  background: rgba(255, 255, 255, 0.3);
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* ======================== */
/* 主内容区域 */
/* ======================== */
.main-content {
  position: relative;
  z-index: 10;
  height: calc(100vh - 88rpx);
  padding: 24rpx;
  padding-top: 0;
  box-sizing: border-box;
}

/* ======================== */
/* 状态卡片 */
/* ======================== */
.status-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 
    0 10rpx 40rpx rgba(0, 0, 0, 0.08),
    0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.status-badge-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(255, 175, 189, 0.35);
}

.status-badge-icon {
  width: 48rpx; /* 状态图标图片宽度 */
  height: 48rpx; /* 状态图标图片高度 */
}

.status-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.status-time {
  font-size: 24rpx;
  color: #8b8fa3;
}

/* 状态卡片装饰圆圈 */
.status-decoration {
  position: absolute;
  right: -40rpx;
  top: 50%;
  transform: translateY(-50%);
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.08;
}

.circle-1 {
  width: 160rpx;
  height: 160rpx;
  background: #667eea;
  right: 0;
  top: -80rpx;
}

.circle-2 {
  width: 100rpx;
  height: 100rpx;
  background: #764ba2;
  right: 80rpx;
  top: -20rpx;
}

.circle-3 {
  width: 60rpx;
  height: 60rpx;
  background: #f472b6;
  right: 40rpx;
  top: 40rpx;
}

/* ======================== */
/* 通用信息卡片 */
/* ======================== */
.info-card {
  background: #ffffff;
  border-radius: 28rpx;
  margin-top: 24rpx;
  padding: 32rpx;
  box-shadow: 
    0 8rpx 30rpx rgba(0, 0, 0, 0.06),
    0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.card-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 175, 189, 0.3);
}

/* 卡片图标 - 图片样式 */
.card-icon {
  width: 32rpx;
  height: 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.card-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 50%;
}

.arrow-text {
  font-size: 32rpx;
  color: #9ca3af;
  font-weight: 300;
  line-height: 1;
}

/* ======================== */
/* 招新信息卡片 */
/* ======================== */
.recruitment-card {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.recruitment-card:active {
  transform: scale(0.98);
}

.recruitment-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.recruitment-cover {
  width: 140rpx;
  height: 100rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.recruitment-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recruitment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recruitment-club {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.club-logo {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #f3f4f6;
}

.club-name {
  font-size: 24rpx;
  color: #6b7280;
}

/* ======================== */
/* 报名信息卡片 - 仪表盘风格 */
/* ======================== */

/* 信息区块容器 */
.info-section {
  margin-bottom: 32rpx;
}

.info-section:last-child {
  margin-bottom: 0;
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.title-line {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background-image: var(--decoration-bg, linear-gradient(135deg, #667eea 0%, #764ba2 100%));
}

.title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  letter-spacing: 2rpx;
}

/* 基础信息网格布局 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-card {
  background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.04),
    0 1rpx 4rpx rgba(0, 0, 0, 0.02),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  transition: all 0.3s ease;
}

.info-card:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    0 1rpx 2rpx rgba(0, 0, 0, 0.02);
}

.card-label {
  font-size: 21rpx;
  color: #9ca3af;
  font-weight: 400;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.card-value {
  font-size: 29rpx;
  color: #5c5c72; /* 基本信息内容颜色调浅 */
  font-weight: 600;
  line-height: 1.4;
}

/* 联系方式网格布局 */
.contact-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(145deg, #ffffff 0%, #fefafa 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.04),
    0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.contact-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.contact-content {
  flex: 1;
  min-width: 0;
}

.contact-label {
  font-size: 21rpx;
  color: #9ca3af;
  font-weight: 400;
  margin-bottom: 8rpx;
}

.contact-value {
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 复制按钮 */
.copy-btn {
  flex-shrink: 0;
  padding: 9rpx 19rpx; /* 增加按钮高度 */
  border-radius: 19rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 175, 189, 0.25);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(255, 175, 189, 0.25);
}

.copy-text {
  font-size: 21rpx;
  color: #ffffff;
  font-weight: 500;
  display: block; /* 文字居中显示 */
  text-align: center; /* 文字居中显示 */
}

/* 详细介绍列表 */
.intro-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.intro-card {
  background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.04),
    0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.intro-label {
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.intro-value {
  font-size: 28rpx;
  color: #374151;
  font-weight: 400;
  line-height: 1.8;
  word-break: break-all;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

/* ======================== */
/* 面试信息卡片 - 时间线样式 */
/* ======================== */
.interview-timeline {
  position: relative;
  padding-left: 40rpx;
}

.interview-timeline::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #e5e7eb 0%, transparent 100%);
}

.timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding-bottom: 28rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(255, 175, 189, 0.4);
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.timeline-label {
  font-size: 22rpx;
  color: #8b8fa3;
}

.timeline-value {
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 500;
}

/* 面试备注 */
.interview-notes {
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border-radius: 20rpx;
}

.notes-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.notes-icon {
  font-size: 24rpx;
}

.notes-title {
  font-size: 24rpx;
  color: #92400e;
  font-weight: 600;
}

.notes-content {
  font-size: 26rpx;
  color: #78350f;
  line-height: 1.6;
}

/* ======================== */
/* 结果备注卡片 */
/* ======================== */
.result-notes-content {
  padding: 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.8;
}

/* ======================== */
/* 操作历史记录卡片 */
/* ======================== */
.logs-card {
  margin-bottom: 24rpx;
}

.logs-timeline {
  position: relative;
  padding-left: 40rpx;
}

.logs-timeline::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #e5e7eb 0%, transparent 100%);
}

.log-item {
  position: relative;
  padding-bottom: 32rpx;
}

.log-item:last-child {
  padding-bottom: 0;
}

.log-dot {
  position: absolute;
  left: -40rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(255, 175, 189, 0.4);
}

.log-content {
  background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.log-action {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.log-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.log-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.log-operator {
  font-size: 24rpx;
  color: #6b7280;
}

.log-status {
  font-size: 24rpx;
  color: #6b7280;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border-radius: 8rpx;
  display: inline-block;
  margin-top: 8rpx;
}

.log-remark {
  margin-top: 12rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
}

/* ======================== */
/* 底部占位 */
/* ======================== */
.bottom-placeholder {
  height: 200rpx;
}

/* ======================== */
/* 底部操作按钮 */
/* ======================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 175, 189, 0.4);
}

.action-btn.primary:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 175, 189, 0.4);
}

.action-btn.secondary {
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  color: #6b7280;
}

.action-btn.secondary:active {
  transform: scale(0.95);
}

.action-btn.full {
  flex: none;
  width: 100%;
}

.btn-icon {
  font-size: 32rpx;
}

/* ======================== */
/* 弹窗遮罩 */
/* ======================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 50%;
  font-size: 28rpx;
  color: #6b7280;
}

/* ======================== */
/* 状态选择器 */
/* ======================== */
.status-options {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.status-option {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.status-option:last-child {
  margin-bottom: 0;
}

.status-option:active {
  transform: scale(0.98);
}

.status-option.active {
  background-image: var(--decoration-bg);
}

.status-option.active .option-label,
.status-option.active .option-desc {
  color: #ffffff;
}

/* 状态选项图标容器 - 使用主题色渐变背景 */
.option-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: var(--decoration-bg, linear-gradient(135deg, #667eea 0%, #764ba2 100%));
  border-radius: 16rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 状态选项图标图片 */
.option-icon-img {
  width: 36rpx;
  height: 36rpx;
}

/* 选中状态下的图标容器 */
.status-option.active .option-icon {
  background: rgba(255, 255, 255, 0.3);
  box-shadow: none;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.option-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.option-desc {
  font-size: 22rpx;
  color: #8b8fa3;
}

.option-check {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  font-size: 28rpx;
  color: #ffffff;
}
