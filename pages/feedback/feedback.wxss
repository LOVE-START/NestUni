/* 主容器 */
.container {
  padding: 30rpx;
  background: linear-gradient(to bottom, #faf8f5, #fff3e6);
  min-height: 100vh;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 顶部标题栏 */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 0 30rpx;
  margin-bottom: 40rpx;
}

.back-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: white;
  border-radius: 50%;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.back-btn:active {
  transform: scale(0.92);
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.05);
}

.back-icon {
  font-size: 36rpx;
  color: #333;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  margin-right: 70rpx; /* 平衡左侧返回按钮 */
  letter-spacing: 1px;
}

/* 个人信息卡片 */
.profile-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  padding: 50rpx 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 
    0 15rpx 35rpx rgba(0, 0, 0, 0.05),
    0 5rpx 15rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
}

/* 装饰元素 */
.decoration-elements {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  gap: 15rpx;
}

.decoration-item {
  font-size: 32rpx;
  animation: twinkle 3s infinite ease-in-out;
}

.decoration-item:nth-child(2) {
  animation-delay: 0.5s;
}

.decoration-item:nth-child(3) {
  animation-delay: 1s;
}

/* 头像区域 */
.avatar-container {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.avatar-circle {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
  padding: 6rpx;
  position: relative;
  box-shadow: 0 8rpx 25rpx rgba(255, 154, 158, 0.5);
}

.avatar-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-text {
  font-size: 80rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
  -webkit-background-clip: text;
  color: transparent;
}

/* 名称和简介 */
.profile-name {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 重新设计的个人简介样式 - 书信风格 */
.profile-bio {
  text-align: center;
  margin-bottom: 45rpx;
  background: rgba(255, 248, 240, 0.3);
  border-radius: 20rpx;
  padding: 35rpx 30rpx;
  position: relative;
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.03);
  /* 删除了原来的重复线性渐变背景 */
  border: 1rpx dashed rgba(255, 154, 158, 0.3); /* 添加虚线边框 */
}

/* 分隔线样式 - 书信风格 */
.bio-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 22rpx 0;
}

.bio-divider-line {
  height: 1rpx;
  width: 100rpx;
  background: repeating-linear-gradient(90deg, 
    rgba(255, 154, 158, 0.3) 0px, 
    rgba(255, 154, 158, 0.3) 4px, 
    transparent 4px, 
    transparent 8px); /* 点线风格 */
}

.bio-divider-icon {
  margin: 0 15rpx;
  font-size: 28rpx;
  animation: heartbeat 4.5s infinite ease-in-out;
}

/* 段落文字样式 - 书信风格 */
.bio-paragraph {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin: 16rpx 0;
  font-weight: 450; /* 轻微调整字重 */
  letter-spacing: 1rpx; /* 增加字间距 */
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  position: relative;
  transition: all 0.3s ease;
  z-index: 1;
  padding: 0 10rpx;
}

.bio-paragraph:hover {
  transform: translateY(-2rpx);
}

/* 高亮文字样式 - 书信风格 */
.bio-highlight {
  margin: 24rpx 0;
  padding: 10rpx 0;
  position: relative;
  z-index: 2;
}

.bio-highlight-text {
  font-weight: 600;
  font-size: 30rpx;
  background: linear-gradient(45deg, #ff9a9e, #ff7b8b, #ff9a9e);
  -webkit-background-clip: text;
  color: transparent;
  padding: 0rpx 15rpx 10rpx;
  letter-spacing: 1.5px;
  animation: colorChange 4.5s infinite ease-in-out; 
  display: inline-block;
  position: relative;
  text-shadow: 0 0 8rpx rgba(255, 123, 139, 0.2);
}

/* 移除高亮文字下划线 */
.bio-highlight-text::after {
  content: none;
}

/* 添加信封装饰元素 */
.profile-bio::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 1rpx dotted rgba(255, 154, 158, 0.2);
  border-radius: 16rpx;
  pointer-events: none;
}

/* 添加信纸质感 */
.profile-bio::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="4" height="4" viewBox="0 0 4 4"><circle cx="1" cy="1" r="0.2" fill="rgba(255, 154, 158, 0.05)"/></svg>');
  opacity: 0.5;
  pointer-events: none;
  z-index: -1;
}

/* 联系方式列表 */
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.contact-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.8), transparent);
  transform: translateX(-100%);
  transition: transform 0.6s ease;
}

.contact-item:active::before {
  transform: translateX(100%);
}

.contact-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.contact-icon-container {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(255, 154, 158, 0.2), rgba(250, 208, 196, 0.2));
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.emoji-icon {
  font-size: 40rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.contact-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.copy-btn {
  padding: 10rpx 25rpx;
  background: linear-gradient(135deg, rgba(255, 154, 158, 0.3), rgba(250, 208, 196, 0.3));
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #ff7b8b;
  font-weight: 500;
  transition: all 0.3s ease;
}

.copy-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 底部装饰 */
.footer-decoration {
  margin-top: 60rpx;
  text-align: center;
}

.footer-stars {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 0 40rpx;
}

.star-item {
  font-size: 24rpx;
  color: #ffb6c1;
  opacity: 0.7;
  animation: twinkle 4s infinite ease-in-out;
}

.star-item:nth-child(odd) {
  animation-delay: 0.5s;
}

.star-item:nth-child(3n) {
  animation-delay: 1s;
}

.star-item:nth-child(4n) {
  animation-delay: 1.5s;
}

.footer-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

/* 动画定义 */
@keyframes twinkle {
  0%, 100% {
    opacity: 0.4;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

@keyframes heartbeat {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.2);
  }
}

@keyframes colorChange {
  0%, 100% {
    opacity: 0.9;
  }
  50% {
    opacity: 1;
  }
}

/* 书信风格的新增元素 */
.letter-header {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 15rpx;
}

/* 信件落款样式 */
.letter-signature {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin: 25rpx 0;
  padding-right: 30rpx;
}

.signature-line {
  width: 120rpx;
  height: 1rpx;
  background: repeating-linear-gradient(90deg, 
    rgba(255, 154, 158, 0.3) 0px, 
    rgba(255, 154, 158, 0.3) 4px, 
    transparent 4px, 
    transparent 8px);
  margin-bottom: 10rpx;
}

.signature-text {
  font-size: 28rpx;
  color: #ff7b8b;
  font-style: italic;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 淡入动画效果 */
.fade-in-item {
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.fade-in-item-show {
  opacity: 1;
  transform: translateY(0);
}