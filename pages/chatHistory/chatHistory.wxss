/* 聊天历史页面样式 */

.history-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 会话列表 */
.session-list {
  padding: 20rpx 24rpx;
  padding-bottom: 160rpx;
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.session-item:active {
  opacity: 0.8;
  transform: scale(0.99);
}

.session-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.session-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.session-content {
  flex: 1;
  min-width: 0;
}

.session-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

.session-delete {
  padding: 12rpx;
  flex-shrink: 0;
}

.delete-icon {
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* 新建对话按钮 */
.new-chat-btn {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 24rpx 80rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
}

.new-chat-btn__text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
