/* 隐藏所有滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
  -webkit-appearance: none;
  background: transparent;
}

/* 针对微信小程序的滚动条隐藏 */
.scroll-view ::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
}

/* 特别针对分类滚动区域隐藏滚动条 */
.categories-kawaii ::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
}

/* 隐藏页面整体滚动条 */
.page ::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
}

/* 隐藏所有scroll-view组件的滚动条 */
scroll-view ::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
}

.page-padding-kawaii {
  margin-top: 20rpx;
  padding: 24rpx;
}

/* 卡通风格 Hero 区域 */
.hero-kawaii {
  border-bottom-left-radius: 50rpx;   
  border-bottom-right-radius: 50rpx;  
  height: 450rpx;
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, #a8c0ff 0%, #3f2b96 100%); /* 更柔和的蓝紫色渐变 */
}

.hero__img-kawaii {
  filter: saturate(1.1) contrast(1.05) brightness(1.02);
  height: 100%;
  width: 100%;
}

.hero__mask-kawaii {
  /* 叠加两层：整体淡白纱柔化过浓的色彩，底部暗渐变保证白色标题可读 */
  background:
    linear-gradient(to bottom, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.32) 100%),
    rgba(255, 255, 255, 0.15);
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}

.hero__title-kawaii {
  bottom: 45rpx;
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
  left: 32rpx;
  position: absolute;
  right: 32rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.2);
  font-family: "Comic Sans MS", "幼圆", cursive;
}

/* 卡通风格搜索栏 */
.search-wrapper-kawaii {
  align-items: center;
  background: #ffffff;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(168, 192, 255, 0.2); /* 使用更柔和的阴影色 */
  display: flex;
  margin-bottom: 30rpx;
  margin-top: 0;
  padding: 16rpx 24rpx;
  border: 3rpx solid #e0e0e0; /* 更柔和的边框色 */
}

.icon-search-kawaii {
  color: #757575; /* 更柔和的图标色 */
  font-size: 32rpx;
}

/* AI图标 - 搜索框右侧 */
.ai-icon-kawaii {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.ai-icon-kawaii image {
  width: 100%;
  height: 100%;
}

.input-kawaii {
  background: #fafafa; /* 更柔和的背景色 */
  border-radius: 50rpx;
  flex: 1;
  font-size: 28rpx;
  margin: 0 16rpx;
  padding: 18rpx 24rpx;
  border: 2rpx dashed #e0e0e0; /* 更柔和的边框色 */
}

/* 卡通风格分类标签区域 */
.categories-kawaii {
  display: flex;
  justify-content: center;
  white-space: nowrap;
  position: relative;
  overflow: visible;
  margin: 25rpx 0;
}

.categories-container-kawaii {
  display: flex;
  padding-top: 20rpx;
  padding-bottom:20rpx;
  position: relative;
  padding-left: 50rpx;
}

/* 卡通风格分类标签 */
.chip--circle-kawaii {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5a5a5a;
  background: #ffffff;
  border: 3rpx solid #e0e0e0; /* 更柔和的边框色 */
  border-radius: 30rpx;
  margin: 0 12rpx;
  box-shadow: 0 6rpx 12rpx rgba(168, 192, 255, 0.2); /* 更柔和的阴影色 */
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  flex-shrink: 0;
  user-select: none;
  position: relative;
  overflow: hidden;
}

.chip--circle-kawaii::before {
  content: "";
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  background: linear-gradient(45deg, 
    rgba(238, 242, 247, 0.3) 0%, 
    rgba(255, 235, 238, 0.3) 25%, 
    rgba(232, 245, 233, 0.3) 50%, 
    rgba(227, 242, 253, 0.3) 75%, 
    rgba(243, 229, 245, 0.3) 100%); /* 更柔和的渐变色 */
  z-index: -1;
  transform: rotate(45deg);
}

.chip-icon {
  width: 45rpx;
  height: 45rpx;
  margin-bottom: 6rpx;
  display: block;
}

.chip-text {
  font-size: 20rpx;
  font-weight: 600;
}

/* 激活状态 */
.chip--circle-kawaii.chip--active-kawaii {
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(168, 192, 255, 0.4); /* 更柔和的阴影色 */
  transform: scale(1.1);
  z-index: 5;
  /* 使用CSS变量设置渐变色 */
  background: var(--active-gradient, linear-gradient(135deg, #a8c0ff 0%, #3f2b96 100%));
}

.chip--circle-kawaii.chip--active-kawaii .chip-icon,
.chip--circle-kawaii.chip--active-kawaii .chip-text {
  color: white;
}

/* 鼠标点击/触摸反馈 */
.chip--circle-kawaii:active {
  transform: scale(0.95);
  opacity: 0.85;
}

/* 悬停效果 */
.chip--circle-kawaii:not(.chip--active-kawaii):hover {
  transform: translateY(-5rpx) scale(1.05);
  box-shadow: 0 8rpx 16rpx rgba(168, 192, 255, 0.3); /* 更柔和的阴影色 */
}

/* 响应式优化 */
@media screen and (max-width: 375px) {
  .chip--circle-kawaii {
    width: 85rpx;
    height: 85rpx;
    margin: 0 8rpx;
  }
  
  .chip-icon {
    font-size: 30rpx;
  }
  
  .chip-text {
    font-size: 18rpx;
  }
}

/* 空态 */
.empty-kawaii {
  color: #757575; /* 更柔和的颜色 */
  padding: 80rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

/* 卡通风格卡片网格 */
.grid-kawaii {
  display: grid;
  gap: 30rpx;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 20rpx;
}

/* 卡通风格卡片基础 */
.card--club-kawaii {
  background: #ffffff;
  border: 3rpx solid #e0e0e0; /* 更柔和的边框色 */
  border-radius: 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(168, 192, 255, 0.2); /* 更柔和的阴影色 */
  margin: 0;
  overflow: hidden;
  padding: 0;
  transition: all 0.3s ease;
  position: relative;
  background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%); /* 更柔和的背景色 */
}

.card--club-kawaii:active {
  box-shadow: 0 16rpx 40rpx rgba(168, 192, 255, 0.3); /* 更柔和的阴影色 */
  transform: translateY(-4rpx);
}

/* 卡片媒体区 */
.card__media-kawaii {
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  height: 280rpx;
  margin: 0;
  overflow: hidden;
  padding: 0;
  position: relative;
}

.card__media-kawaii image {
  border-radius: 0;
  display: block;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
  width: 100%;
}

.card__media-kawaii image:active {
  transform: scale(1.05);
}

/* 卡片媒体区覆盖层 */
.card__overlay-kawaii {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	align-items: flex-start;
	justify-content: space-between; /* 左右两侧分布 */
	padding: 20rpx;
	pointer-events: none;
}

/* 人数标签样式 - 透明玻璃效果 */
.card__badge-kawaii {
	align-items: center;
	background: rgba(255, 255, 255, 0.75);
	backdrop-filter: blur(16rpx) saturate(180%);
	-webkit-backdrop-filter: blur(16rpx) saturate(180%);
	border-radius: 24rpx;
	box-shadow: 
		0 8rpx 24rpx rgba(168, 192, 255, 0.25),
		0 2rpx 8rpx rgba(255, 255, 255, 0.3),
		inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
	display: flex;
	justify-content: center;
	padding: 10rpx 20rpx;
	border: 2rpx solid rgba(255, 255, 255, 0.5);
	pointer-events: auto;
}

.badge__text-kawaii {
	color: #5a5a5a;
	font-size: 22rpx;
	font-weight: 700;
	text-shadow: 0 0 8rpx rgba(255, 255, 255, 0.3);
}

/* 招新ing标签样式 - 透明粉色玻璃效果 */
.card__recruit-badge-kawaii {
	align-items: center;
	background: linear-gradient(135deg, 
		rgba(255, 134, 138, 0.75) 0%, 
		rgba(255, 133, 208, 0.7) 100%);
	backdrop-filter: blur(16rpx) saturate(180%);
	-webkit-backdrop-filter: blur(16rpx) saturate(180%);
	border-radius: 24rpx;
	box-shadow: 
		0 8rpx 24rpx rgba(255, 154, 158, 0.35),
		0 2rpx 8rpx rgba(254, 207, 239, 0.25),
		inset 0 2rpx 4rpx rgba(255, 255, 255, 0.4);
	display: flex;
	justify-content: center;
	padding: 10rpx 18rpx;
	border: 2rpx solid rgba(255, 255, 255, 0.5);
	pointer-events: auto;
}

.recruit-badge__text-kawaii {
	color: #ffffff;
	font-size: 20rpx;
	font-weight: 700;
	text-shadow: 
		0 1rpx 3rpx rgba(255, 154, 158, 0.5),
		0 0 8rpx rgba(255, 255, 255, 0.3);
	letter-spacing: 1rpx;
}

/* 卡片正文 */
.card__body-kawaii {
  padding: 0;
}

.card__header-kawaii {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 24rpx 24rpx 0 24rpx;
}

.card__title-kawaii {
  color: #5f5f5f; /* 更柔和的颜色 */
  flex: 1;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
  margin-right: 12rpx;
}

.card__subtitle-kawaii {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #7a7a7a;
  display: -webkit-box;
  font-size: 24rpx;
  line-height: 1.4;
  margin-bottom: 16rpx;
  overflow: hidden;
  padding: 0 24rpx;
}

.card__tags-kawaii {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
}

.card__tag-kawaii {
  background: linear-gradient(135deg, #e0e0e0 0%, #bdbdbd 100%); /* 更柔和的标签背景色 */
  border: 2rpx solid #9e9e9e; /* 更柔和的边框色 */
  border-radius: 24rpx;
  color: #424242; /* 更柔和的文字色 */
  font-size: 20rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
}

/* 卡片底部 */
.card__footer-kawaii {
  align-items: center;
  border-top: 2rpx dashed #e0e0e0; /* 更柔和的边框色 */
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx 24rpx 24rpx;
}

.card__location-kawaii {
  align-items: center;
  display: flex;
}

.location__icon-kawaii {
  font-size: 22rpx;
  margin-right: 6rpx;
  color: #757575; /* 更柔和的颜色 */
}

.location__text-kawaii {
  color: #7a7a7a;
  font-size: 22rpx;
  font-weight: 600;
}

.card__status-kawaii {
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 14rpx;
  border: 2rpx solid;
  /* 使用CSS变量设置背景渐变色 */
  background: var(--status-gradient, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  border-color: rgba(255, 255, 255, 0.3);
  color: white;
}

.status--active-kawaii {
  /* 学术分类使用主题渐变色 */
  background: var(--status-gradient, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

.status--inactive-kawaii {
  /* 其他分类也使用主题渐变色，但可以调整透明度或其他效果 */
  background: var(--status-gradient, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  opacity: 0.8;
}

.status__text-kawaii {
  font-size: 20rpx;
}

/* 基础留白 */
.safe-bottom-kawaii {
  height: 150rpx;        
  background: transparent; 
}

/* 兼容 iPhone 底部安全区 */
@supports (padding-bottom: constant(safe-area-inset-bottom)) {
  .safe-bottom-kawaii {
      height: calc(150rpx + constant(safe-area-inset-bottom));
  }
}
@supports (padding-bottom: env(safe-area-inset-bottom)) {
  .safe-bottom-kawaii {
      height: calc(150rpx + env(safe-area-inset-bottom));
  }
}