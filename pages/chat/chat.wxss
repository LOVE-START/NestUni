  box-shadow: 0 0 40rpx rgba(156, 163, 175, 0.4), 0 0 80rpx rgba(156, 163, 175, 0.2);
}

.badge-card-new--common .badge-card__icon {
  filter: drop-shadow(0 0 16rpx rgba(156, 163, 175, 0.6));
}

/* 羽章稀有度样式 - 稀有 */
.badge-card-new--rare .badge-card__icon-wrapper {
  background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, transparent 70%);
  box-shadow: 0 0 40rpx rgba(59, 130, 246, 0.5), 0 0 80rpx rgba(59, 130, 246, 0.25);
}

.badge-card-new--rare .badge-card__icon {
  filter: drop-shadow(0 0 20rpx rgba(59, 130, 246, 0.7));
}

/* 羽章稀有度样式 - 史诗 */
.badge-card-new--epic .badge-card__icon-wrapper {
  background: radial-gradient(circle, rgba(168, 85, 247, 0.3) 0%, transparent 70%);
  box-shadow: 0 0 40rpx rgba(168, 85, 247, 0.5), 0 0 80rpx rgba(168, 85, 247, 0.25);
}

.badge-card-new--epic .badge-card__icon {
  filter: drop-shadow(0 0 24rpx rgba(168, 85, 247, 0.8));
}

/* 羽章稀有度样式 - 传说 */
.badge-card-new--legendary .badge-card__icon-wrapper {
  background: radial-gradient(circle, rgba(251, 191, 36, 0.35) 0%, transparent 70%);
  box-shadow: 0 0 50rpx rgba(251, 191, 36, 0.6), 0 0 100rpx rgba(251, 191, 36, 0.3);
  animation: legendary-glow-pulse 2s ease-in-out infinite;
}

.badge-card-new--legendary .badge-card__icon {
  filter: drop-shadow(0 0 28rpx rgba(251, 191, 36, 0.9));
  animation: legendary-icon-glow 2s ease-in-out infinite;
}

@keyframes legendary-glow-pulse {
  0%, 100% {
    box-shadow: 0 0 50rpx rgba(251, 191, 36, 0.6), 0 0 100rpx rgba(251, 191, 36, 0.3);
  }
  50% {
    box-shadow: 0 0 60rpx rgba(251, 191, 36, 0.8), 0 0 120rpx rgba(251, 191, 36, 0.4);
  }
}

@keyframes legendary-icon-glow {
  0%, 100% {
    filter: drop-shadow(0 0 28rpx rgba(251, 191, 36, 0.9));
  }
  50% {
    filter: drop-shadow(0 0 36rpx rgba(251, 191, 36, 1));
  }
}

