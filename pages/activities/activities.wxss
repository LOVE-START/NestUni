/* 隐藏所有滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
  -webkit-appearance: none;
  background: transparent;
}

/* 针对微信小程序的滚动条隐藏 */
.scroll-view ::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
}

/* 特别针对分类滚动区域隐藏滚动条 */
.categories-scroll ::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
}

/* 隐藏页面整体滚动条 */
.page ::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
}

/* 隐藏所有scroll-view组件的滚动条 */
scroll-view ::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
}

.activities-page {
  background: #f8fafc;
  min-height: 100vh;
  padding-bottom: 160rpx; /* 给底部留更宽空间 */
}

/* Hero 横幅 */
.hero {
  position: relative;
  height: 480rpx;
  overflow: hidden;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: #e2e8f0;
}

.hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(1) saturate(1.05);
}

.hero__mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15), rgba(0,0,0,0.1));
}

.hero__title {
  position: absolute;
  bottom: 90rpx;
  left: 40rpx;
  right: 40rpx;
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.hero__subtitle {
  position: absolute;
  bottom: 46rpx;
  left: 40rpx;
  color: rgba(255,255,255,0.92);
  font-size: 28rpx;
  font-weight: 400;
}


/* 搜索栏 */
.search-container {
  padding: 36rpx 32rpx 20rpx;
}

.search-wrapper {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
  transition: box-shadow 0.3s ease;
  border: 1rpx solid #e2e8f0;
}

.search-wrapper:focus-within {
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
}

.search-input {
  background: #f5f6fa;
  border-radius: 999rpx;
  flex: 1;
  font-size: 28rpx;
  margin: 0 16rpx;
  padding: 16rpx 20rpx;
  color: #1e293b;
  border: none;
  outline: none;
}

.icon-search,
.icon-calendar {
  font-size: 34rpx;
  color: #64748b;
}

.search-action {
  color: #7a808a;
  font-size: 28rpx;
  padding: 0 10rpx;
}

/* 🥚 正方形恐龙蛋按钮 */

.categories-scroll {
  padding: 12rpx 0 28rpx;     /* ✅ 再次缩小上下边距 */
  white-space: nowrap;
  margin-top: -10rpx;
}

.categories {
  display: flex;
  overflow-x: auto;
  padding: 6rpx 18rpx;        /* ✅ 水平边距更紧凑 */
  gap: 20rpx;                 /* ✅ 按钮间距更小 */
}

/* 分类按钮核心样式 */
.chip {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 112rpx;              /* 恢复原来的宽度 */
  height: 96rpx;              /* 恢复原来的高度 */
  border-radius: 40rpx;       /* ✅ 圆角比例依然柔和 */

  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  color: #334155;
  font-size: 24rpx;
  font-weight: 600;

  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.04);
  transition: all 0.25s ease;
  flex-shrink: 0;
}

/* 激活态 */
.chip--active {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: #fff;
  box-shadow: 0 5rpx 14rpx rgba(31,27,23,0.25);
}

/* 点击动画 */
.chip:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 内部元素 */
.chip-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 8rpx;  /* 改为左边距 */
  opacity: 0.9;
}

.chip-text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.3rpx;
  text-align: center;
  line-height: 1.1;
}


/* 活动容器 */
.events-container {
  padding: 0 32rpx 48rpx;
  background-color: #f8fafc;
}

/* 单列布局 */
.events-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 卡片风格 */
.event-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  border: 1rpx solid #e2e8f0;
}

.event-card:active {
  transform: scale(0.98);
}

/* 图片区域 */
.event-image-container {
  position: relative;
  width: 100%;
  height: 260rpx; /* ✅ 缩小高度（原360rpx） */
  border-bottom: 1rpx solid #f1f5f9;
}

.event-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 0;
}

/* 状态标签 */
.event-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: white;
  backdrop-filter: blur(10px);
  background: rgba(0, 0, 0, 0.45);
  z-index: 2;
}

.event-status.preparing {
  background-image: var(--decoration-bg, linear-gradient(135deg, #ff9d2e, #ffb84c));
}

.event-status.ongoing {
  background-image: var(--decoration-bg, linear-gradient(135deg, #20bf6b, #0fb9b1));
}

.event-status.active {
  background-image: var(--decoration-bg, linear-gradient(135deg, #16a34a, #22c55e));
}

.event-status.upcoming {
  background-image: var(--decoration-bg, linear-gradient(135deg, #2563eb, #3b82f6));
}

.event-status.ended {
  background-image: var(--decoration-bg, linear-gradient(135deg, #6b7280, #9ca3af));
}

.event-status.cancelled {
  background-image: var(--decoration-bg, linear-gradient(135deg, #dc2626, #ef4444));
}

/* 分类标签 */
.event-category-tag {
  position: absolute;
  bottom: 14rpx;
  left: 20rpx;
  padding: 8rpx 18rpx;
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: #fff;
  border-radius: 22rpx;
  font-size: 20rpx;
  font-weight: 500;
  backdrop-filter: blur(10px);
  z-index: 2;
}

/* 信息部分 */
.event-info {
  padding: 24rpx 28rpx 28rpx;
}

.event-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  position: relative;
}

.event-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 40%;
  height: 4rpx;
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  border-radius: 4rpx;
}

/* 横向布局容器：左meta + 右actions */
.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

/* 左侧meta横排 */
.event-meta {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  flex-wrap: wrap;
}

/* 每一项的图标和文字对齐 */
.meta-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #555;
  background: #f8fafc;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.meta-icon {
  margin-right: 6rpx;
  font-size: 26rpx;
}

/* 右侧操作按钮区域 */
.event-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  flex-shrink: 0;
}

/* 报名按钮样式 */
.join-btn {
  background-image: var(--decoration-bg, linear-gradient(to bottom, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(0, 122, 255, 0.2);
  transition: all 0.3s ease;
  white-space: nowrap;
}

.join-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 122, 255, 0.3);
}

.joined-btn {
  background-image: var(--decoration-bg, linear-gradient(to bottom, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(0, 122, 255, 0.2);
  opacity: 0.8;
}

/* 加载更多 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #666;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
}

/* 参与者头像容器 */
.event-participants {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  margin-bottom:-10rpx;
  border-top: 1rpx solid #f1f5f9;
}

/* 主题色边框包装 */
.participant-avatar-wrapper {
  display: inline-block;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 交叠头像容器 */
.participant-avatar-wrapper.overlap {
  width: 70rpx;
  height: 50rpx;
  background: transparent;
  margin-right: 0;
}

/* 交叠头像样式 */
.participant-avatar.overlap-avatar {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  background: #f8fafc;
  left: 0;
  z-index: 3;
}

.participant-avatar.overlap-avatar.second {
  left: 20rpx;
  z-index: 2;
}

.participant-avatar.overlap-avatar.third {
  left: 40rpx;
  z-index: 1;
}

/* 参与者头像 */
.participant-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  background: #f8fafc;
}

/* 社团头像 */
.club-avatar {
  background: #f8fafc;
}

/* 用户头像 */
.user-avatar {
  background: #e2e8f0;
}

/* 省略号样式 */
.ellipsis-wrapper {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: none;
}

.ellipsis {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}
