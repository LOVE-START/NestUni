/* ======================== */
/* 🌿 页面整体风格 */
/* ======================== */
.activities-detail-page {
  background-color: #f9fafb;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, 'Open Sans', sans-serif;
  padding-bottom: 40rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #4a90e2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ======================== */
/* 🎴 顶部封面区域 */
/* ======================== */
.cover-container {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

.cover-swiper, .cover-image {
  width: 100%;
  height: 100%;
}

.cover-image {
  object-fit: cover;
  transform: scale(1.03);
  transition: transform 0.8s ease;
}

/* 活动分类标签 */
.event-category-tag {
  position: absolute;
  top: 48rpx;
  right: 24rpx;
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(255, 175, 189, 0.3);
}

.tag-text {
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.2);
}

/* 活动状态标签 */
.event-status {
  position: absolute;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(255, 175, 189, 0.3);
  backdrop-filter: blur(10px);
  text-align: center;
  min-width: 120rpx;
}

.event-status.preparing {
  background-image: var(--decoration-bg, linear-gradient(to right, #ffb84c, #ff9d2e));
}

.event-status.ongoing {
  background-image: var(--decoration-bg, linear-gradient(to right, #20bf6b, #0fb9b1));
}

.event-status.active {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

.event-status.upcoming {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

.event-status.ended {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

.event-status.cancelled {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

/* ======================== */
/* 🏛️ 活动信息卡片 */
/* ======================== */
.event-card {
  margin: -60rpx 24rpx 24rpx;
  padding: 36rpx;
  background-color: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}

.event-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.event-title-info {
  flex: 1;
  margin-left: 4rpx;
  padding-top: 8rpx;
}

.event-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: #222;
  position: relative;
  display: inline-block;
  letter-spacing: 0.5rpx;
}

.event-name::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 0;
  width: 40%;
  height: 4rpx;
  background-image: var(--decoration-bg);
  border-radius: 4rpx;
}

/* 报名按钮样式 */
.join-button, .cancel-join-button {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.join-button:active, .cancel-join-button:active {
  transform: scale(0.95);
}

.cancel-join-button {
  background-image: var(--decoration-bg, linear-gradient(to right, #94a3b8, #64748b));
}

/* 信息徽章 - 使用space-evenly确保均匀分布 */
.info-badges {
  display: flex;
  justify-content: space-evenly;
  margin: 30rpx 0 0;
  padding: 24rpx 0 0;
  border-top: 1rpx solid #f0f0f0;
}

/* 每个勋章项 - 固定等宽确保居中对齐 */
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 200rpx;
}

/* 地点点击区域样式 */
.location-clickable {
  position: relative;
  cursor: pointer;
  transition: all 0.3s ease;
}

.location-clickable:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.location-arrow {
  position: absolute;
  right: -16rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #c0c0c0;
  font-weight: 300;
}

.badge-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

.badge-icon {
  width: 40rpx;
  height: 40rpx;
}

.badge-value {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
  color: #333;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.badge-label {
  font-size: 22rpx;
  color: #888;
}

/* ======================== */
/* 📘 模块通用样式 */
/* ======================== */
.section-container {
  margin: 0 24rpx 30rpx;
  border-radius: 24rpx;
  background-color: white;
  padding: 24rpx 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.section-header {
  margin-bottom: 24rpx;
  color: #222;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
  position: relative;
  padding-left: 20rpx;
  color: #333;
}

.section-title-text::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  border-radius: 3rpx;
}

.section-content {
  font-size: 26rpx;
  color: #444;
  line-height: 1.8;
}

/* 活动完整介绍 */
.event-full-description {
  font-size: 26rpx;
  color: #444;
  line-height: 1.8;
}

/* ======================== */
/* 📷 活动图片 */
/* ======================== */
.event-images-container {
  width: 100%;
  overflow-x: auto;
  /* 隐藏滚动条 */
  -ms-overflow-style: none; /* IE 和 Edge */
  scrollbar-width: none; /* Firefox */
}

.event-images-container::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Opera */
}

.event-images {
  display: flex;
  gap: 10rpx;
  padding: 10rpx 0;
  min-width: 100%;
  width: max-content;
}

.event-image {
  width: 280rpx;
  height: 200rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  object-fit: cover;
  flex-shrink: 0;
}

/* ======================== */
/* 📋 报名信息 */
/* ======================== */
.registration-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #94a3b8;
  width: 180rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.value {
  font-size: 26rpx;
  color: #1e293b;
  flex: 1;
  font-weight: 500;
}

/* ======================== */
/* 🏷️ 标签和要求 */
/* ======================== */
.tags-requirements {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 8rpx;
  transition: all 0.3s ease;
  border: 1rpx solid #e2e8f0;
}

.tag-item::before {
  content: "#";
  margin-right: 4rpx;
  opacity: 0.8;
}

.tag-item:active {
  transform: scale(0.95);
  background: #e2e8f0;
}

.requirements-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.requirement-item {
  background: #f8fafc;
  color: #475569;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  border: 1rpx solid #e2e8f0;
}

.requirement-item:hover {
  background: #f1f5f9;
  transform: translateX(4rpx);
}

.requirement-item::before {
  content: "✓";
  font-weight: bold;
  flex-shrink: 0;
  color: #64748b;
}

/* 当标签或要求容器为空时的提示 */
.tags-requirements .empty-hint {
  font-size: 24rpx;
  color: #94a3b8;
  font-style: italic;
  text-align: center;
  padding: 20rpx;
}

/* ======================== */
/* 🔐 解密游戏提示动画 */
/* ======================== */
@keyframes pulse {
  0% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255, 175, 189, 0.4);
  }
  70% {
    transform: scale(1.02);
    box-shadow: 0 0 0 10rpx rgba(255, 175, 189, 0);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(255, 175, 189, 0);
  }
}

.pulse-animation {
  animation: pulse 2s infinite;
}