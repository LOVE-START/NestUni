<theme-provider id="themeProvider" bind:themeChange="onThemeChange">
  <view wx:if="{{permissionChecked && !hasPermission}}" class="no-permission-page">
  </view>

  <view wx:elif="{{permissionChecked && hasPermission}}" class="page" style="--theme-gradient: {{theme.gradient}}; --theme-primary: {{theme.colors.primary}}; --decoration-bg: {{theme.gradient}}">
    <!-- 顶部装饰背景 -->
    <view class="header-decoration" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg)">
      <view class="header-pattern"></view>
      
      <!-- 自定义导航栏 -->
      <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
        <view class="nav-content">
          <view class="nav-left" bindtap="goBack">
            <image class="nav-back-icon" src="/images/back.png" mode="aspectFit" />
          </view>
          <view class="nav-title">我的报名</view>
          <view class="nav-right"></view>
        </view>
      </view>

      <!-- 统计数据 - 直接显示在背景上 -->
      <view class="stats-inline">
        <view class="stats-inline__item">
          <view class="stats-inline__num">{{stats.total}}</view>
          <view class="stats-inline__label">总报名</view>
        </view>
        <view class="stats-inline__divider"></view>
        <view class="stats-inline__item">
          <view class="stats-inline__num">{{stats.interviewing}}</view>
          <view class="stats-inline__label">面试中</view>
        </view>
        <view class="stats-inline__divider"></view>
        <view class="stats-inline__item">
          <view class="stats-inline__num">{{stats.accepted}}</view>
          <view class="stats-inline__label">已录取</view>
        </view>
      </view>
    </view>

    <!-- 状态筛选 - 简约线条风格 -->
    <view class="filter-section">
      <scroll-view scroll-x class="filter-scroll" show-scrollbar="{{false}}">
        <view class="filter-list">
          <view
            class="filter-tab {{currentStatus === 'all' ? 'filter-tab--active' : ''}}"
            bindtap="onStatusChange"
            data-status="all"
          >全部</view>
          <view class="filter-divider"></view>
          <view
            class="filter-tab {{currentStatus === 'submitted' ? 'filter-tab--active' : ''}}"
            bindtap="onStatusChange"
            data-status="submitted"
          >已提交</view>
          <view class="filter-divider"></view>
          <view
            class="filter-tab {{currentStatus === 'viewed' ? 'filter-tab--active' : ''}}"
            bindtap="onStatusChange"
            data-status="viewed"
          >已查看</view>
          <view class="filter-divider"></view>
          <view
            class="filter-tab {{currentStatus === 'interviewing' ? 'filter-tab--active' : ''}}"
            bindtap="onStatusChange"
            data-status="interviewing"
          >面试中</view>
          <view class="filter-divider"></view>
          <view
            class="filter-tab {{currentStatus === 'accepted' ? 'filter-tab--active' : ''}}"
            bindtap="onStatusChange"
            data-status="accepted"
          >已录取</view>
        </view>
      </scroll-view>
      <view class="filter-underline"></view>
    </view>

    <!-- 报名列表 -->
    <scroll-view
      scroll-y
      class="list-section"
      bindscrolltolower="loadMore"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onPullDownRefresh"
    >
      <view class="list-container">
        <!-- 报名卡片 -->
        <view
          class="app-card"
          wx:for="{{applications}}"
          wx:key="id"
          bindtap="goToDetail"
          data-id="{{item.id}}"
        >
          <!-- 卡片头部 -->
          <view class="app-card__header">
            <image class="app-card__cover" src="{{item.recruitment_cover || '/images/default-avatar.png'}}" mode="aspectFill" />
            <view class="app-card__info">
              <view class="app-card__title">{{item.recruitment_title}}</view>
              <view class="app-card__club">
                <image class="app-card__avatar" src="{{item.club_logo || '/images/default-avatar.png'}}" mode="aspectFill" />
                <text class="app-card__club-name">{{item.club_name}}</text>
              </view>
            </view>
            <!-- 状态标签 -->
            <view class="app-card__status app-card__status--{{item.status}}">
              <text class="app-card__status-text">{{item.statusText}}</text>
            </view>
          </view>

          <!-- 卡片底部 -->
          <view class="app-card__footer">
            <view class="app-card__time">
              <image class="app-card__time-icon" src="/images/time.png" mode="aspectFit" />
              <text class="app-card__time-text">{{item.formatted_submitted_at}}</text>
            </view>

            <!-- 面试信息 -->
            <view class="app-card__interview" wx:if="{{item.status === 'interviewing' && item.interview_time}}">
              <image class="app-card__interview-icon" src="/images/calendar.png" mode="aspectFit" />
              <text class="app-card__interview-text">{{item.formatted_interview_time}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载状态 -->
      <view class="load-state" wx:if="{{applications.length > 0}}">
        <view wx:if="{{loading}}" class="loading">
          <view class="loading-dot"></view>
          <view class="loading-dot"></view>
          <view class="loading-dot"></view>
        </view>
        <view wx:elif="{{!hasMore}}" class="no-more">
          <text class="no-more__text">已经到底啦</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!applications.length && !loading}}">
        <view class="empty-icon-wrap" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg)">
          <image class="empty-icon" src="/images/post.png" mode="aspectFit" />
        </view>
        <view class="empty-title">暂无报名记录</view>
        <view class="empty-desc">快去发现感兴趣的社团吧</view>
        <view class="empty-btn" bindtap="goToRecruitment" style="--decoration-bg: {{theme.gradientButton}}; background-image: var(--decoration-bg)">
          <text class="empty-btn__text">浏览社团</text>
        </view>
      </view>

      <view class="safe-bottom"></view>
    </scroll-view>
  </view>
</theme-provider>
