/* Agent操作确认卡片 - 与聊天页AI气泡同质感的轻卡片，主题色以含蓄方式出现 */

/* 卡片容器 - 略微透白的卡片 + 主题色极淡染色 + 大圆角 + 极淡投影 */
.agent-card {
  position: relative;
  margin: 16rpx 0 8rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 主题色极淡染色层 - 让卡片带一点当前主题的气息，而非纯白 */
.agent-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--card-gradient);
  opacity: 0.04;
  z-index: 0;
}

/* 已处理态：整体降低存在感 */
.agent-card--resolved {
  opacity: 0.65;
}

/* 卡片内容区 - 置于染色层之上 */
.agent-card__content {
  position: relative;
  z-index: 1;
  padding: 22rpx 28rpx 24rpx;
}

/* 状态徽标 - 主题色淡化小胶囊 */
.agent-card__badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 5rpx 16rpx;
  margin-bottom: 14rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

/* 主题色淡化装饰层 - 用伪元素承载渐变并降透明度，不影响文字可读性 */
.agent-card__badge::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--card-gradient);
  opacity: 0.22;
}

/* 内容层浮于淡化底色之上 */
.agent-card__badge-dot,
.agent-card__badge-text {
  position: relative;
}

/* 徽标呼吸圆点 - 提示此处等待用户决策 */
.agent-card__badge-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #8a8a93;
  animation: badgePulse 2s ease-in-out infinite;
}

.agent-card__badge-text {
  font-size: 20rpx;
  color: #6b6b73;
}

/* 呼吸动画 - 与消息加载点同语言的柔和节奏 */
@keyframes badgePulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(0.7); opacity: 0.45; }
}

/* 操作标题 - 中等字重，避免过重的视觉压迫 */
.agent-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #3a3a44;
  margin-bottom: 14rpx;
}

/* 摘要信息行 */
.agent-card__row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
  padding: 12rpx 0;
}

/* 行间极淡分隔线，保持轻盈（首行不显示） */
.agent-card__row + .agent-card__row {
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.agent-card__label {
  font-size: 24rpx;
  color: #a3a3ad;
  flex-shrink: 0;
}

.agent-card__value {
  font-size: 24rpx;
  color: #4a4a55;
  text-align: right;
  word-break: break-all;
  line-height: 1.5;
}

/* 审核正文区 - 活动描述/公告内容，左对齐便于长文阅读，与上方信息行以发丝线分隔 */
.agent-card__long {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* 正文标题 - 弱化颜色，避免与操作标题抢层级 */
.agent-card__long-label {
  display: block;
  font-size: 24rpx;
  color: #a3a3ad;
  margin-bottom: 8rpx;
}

/* 正文内容 - 保留换行、长串自动折行，卡片高度随内容自然撑开 */
.agent-card__long-text {
  display: block;
  font-size: 25rpx;
  color: #4a4a55;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* 未填写占位 - 弱化显示，与审核中心详情抽屉的表达一致 */
.agent-card__long-text--empty {
  color: #c0c0c8;
}

/* 操作按钮区 */
.agent-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 药丸按钮 - 与输入栏发送按钮同款形态，覆盖button默认样式 */
.agent-card__btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  height: 60rpx !important;
  padding: 0 36rpx !important;
  margin: 0 !important;
  border-radius: 40rpx !important;
  font-size: 25rpx !important;
  line-height: 60rpx !important;
  transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s;
}

/* 去除button默认描边，保持药丸干净 */
.agent-card__btn::after {
  border: none;
}

/* 按钮点击反馈 - 与导航按钮同款缩放 */
.agent-card__btn:active {
  transform: scale(0.94);
  opacity: 0.9;
}

/* 取消按钮 - 浅灰柔和，文案"再想想"更口语化 */
.agent-card__btn--cancel {
  background: rgba(0, 0, 0, 0.04) !important;
  color: #8a8a93 !important;
}

/* 确认按钮 - 主题渐变药丸 */
.agent-card__btn--confirm {
  background: var(--card-gradient) !important;
  color: #fff !important;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
}

/* 已处理标识 - 柔绿小对勾 */
.agent-card__done {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  padding-top: 8rpx;
  font-size: 24rpx;
  color: #9a9aa3;
}

.agent-card__done-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(52, 199, 89, 0.12);
  color: #2e9e4f;
  font-size: 18rpx;
}
