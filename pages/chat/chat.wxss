/* 羽章卡片 - swiper item添加间距 */
.badge-swiper-item {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 16rpx;
  box-sizing: border-box;
}

/* 羽章卡片 - 图标居中 + 信息区 */
.badge-card-new {
  width: 100%;
