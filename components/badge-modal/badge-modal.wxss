/* 羽章详情弹窗 - 暗色沉浸式设计 */

/* ===== 遮罩层 - 全屏暗色背景 ===== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, #1c1c1e 0%, #0a0a0c 100%);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  animation: fadeIn .3s ease forwards;
}

@keyframes fadeIn { 
  from { opacity: 0 } 
  to { opacity: 1 } 
}

/* ===== 粒子系统容器 ===== */
.particle-system {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
}

/* 背景光环 - 旋转发光，与羽章大图区域匹配 */
.particle-system::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
  transform: translate(-50%, calc(-50% - 300rpx));
  animation: ring-rotate 8s linear infinite;
  opacity: 0;
}

.modal-overlay.show .particle-system::before {
  animation: ring-rotate 8s linear infinite, ring-fade-in 1s ease forwards;
}

@keyframes ring-rotate {
  from {
    transform: translate(-50%, calc(-50% - 300rpx)) rotate(0deg);
  }
  to {
    transform: translate(-50%, calc(-50% - 300rpx)) rotate(360deg);
  }
}

@keyframes ring-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 不同稀有度的光环颜色 */
.particle-legendary::before {
  border-color: rgba(255, 215, 0, 0.3);
  box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.2), inset 0 0 40rpx rgba(255, 215, 0, 0.1);
}

.particle-epic::before {
  border-color: rgba(168, 85, 247, 0.3);
  box-shadow: 0 0 40rpx rgba(168, 85, 247, 0.2), inset 0 0 40rpx rgba(168, 85, 247, 0.1);
}

.particle-rare::before {
  border-color: rgba(59, 130, 246, 0.3);
  box-shadow: 0 0 40rpx rgba(59, 130, 246, 0.2), inset 0 0 40rpx rgba(59, 130, 246, 0.1);
}

.particle-common::before {
  border-color: rgba(156, 163, 175, 0.2);
  box-shadow: 0 0 40rpx rgba(156, 163, 175, 0.1), inset 0 0 40rpx rgba(156, 163, 175, 0.05);
}

/* 光芒射线 - 与羽章大图区域重合 */
.light-rays {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 440rpx;
  height: 400rpx;
  transform: translate(-50%, calc(-50% - 300rpx));
  z-index: 0;
}

.ray {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 2rpx;
  height: 200rpx;
  transform-origin: bottom center;
  opacity: 0;
}

.modal-overlay.show .ray {
  animation: ray-burst 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

.ray-1 { transform: translate(-50%, -100%) rotate(0deg); animation-delay: 0s; }
.ray-2 { transform: translate(-50%, -100%) rotate(45deg); animation-delay: 0.05s; }
.ray-3 { transform: translate(-50%, -100%) rotate(90deg); animation-delay: 0.1s; }
.ray-4 { transform: translate(-50%, -100%) rotate(135deg); animation-delay: 0.15s; }
.ray-5 { transform: translate(-50%, -100%) rotate(180deg); animation-delay: 0.2s; }
.ray-6 { transform: translate(-50%, -100%) rotate(225deg); animation-delay: 0.25s; }
.ray-7 { transform: translate(-50%, -100%) rotate(270deg); animation-delay: 0.3s; }
.ray-8 { transform: translate(-50%, -100%) rotate(315deg); animation-delay: 0.35s; }

@keyframes ray-burst {
  0% {
    height: 0;
    opacity: 0.8;
  }
  50% {
    height: 250rpx;
    opacity: 0.4;
  }
  100% {
    height: 200rpx;
    opacity: 0;
  }
}

/* 飘落粒子 - 只执行一次 */
.floating-particles {
  position: absolute;
  width: 100%;
  height: 100%;
}

.float-particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  opacity: 0;
}

.modal-overlay.show .float-particle {
  animation: float-down 3s ease-in-out forwards;
}

.fp-1 { left: 10%; top: -10rpx; animation-delay: 0s; }
.fp-2 { left: 20%; top: -20rpx; animation-delay: 0.3s; }
.fp-3 { left: 30%; top: -15rpx; animation-delay: 0.6s; }
.fp-4 { left: 40%; top: -25rpx; animation-delay: 0.9s; }
.fp-5 { left: 50%; top: -10rpx; animation-delay: 1.2s; }
.fp-6 { left: 60%; top: -20rpx; animation-delay: 1.5s; }
.fp-7 { left: 70%; top: -15rpx; animation-delay: 1.8s; }
.fp-8 { left: 80%; top: -25rpx; animation-delay: 2.1s; }
.fp-9 { left: 15%; top: -30rpx; animation-delay: 0.5s; }
.fp-10 { left: 45%; top: -35rpx; animation-delay: 1.0s; }
.fp-11 { left: 75%; top: -30rpx; animation-delay: 1.5s; }
.fp-12 { left: 85%; top: -35rpx; animation-delay: 2.0s; }

@keyframes float-down {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(120vh) rotate(360deg);
    opacity: 0;
  }
}

/* 闪烁星点 */
.sparkles {
  position: absolute;
  width: 100%;
  height: 100%;
}

.sparkle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  opacity: 0;
}

.modal-overlay.show .sparkle {
  animation: sparkle-blink 2s ease-in-out infinite;
}

.s-1 { left: 15%; top: 20%; animation-delay: 0s; }
.s-2 { left: 35%; top: 45%; animation-delay: 0.4s; }
.s-3 { left: 65%; top: 25%; animation-delay: 0.8s; }
.s-4 { left: 85%; top: 55%; animation-delay: 1.2s; }
.s-5 { left: 25%; top: 70%; animation-delay: 1.6s; }
.s-6 { left: 75%; top: 80%; animation-delay: 2.0s; }

@keyframes sparkle-blink {
  0%, 100% {
    opacity: 0;
    transform: scale(0.5);
  }
  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

/* ===== 稀有度粒子颜色 ===== */
/* 传说 - 金色 */
.particle-legendary .ray {
  background: linear-gradient(to top, transparent, #ffd700, transparent);
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.8);
}

.particle-legendary .float-particle {
  background: #ffd700;
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.8);
}

.particle-legendary .sparkle {
  background: #ffd700;
  box-shadow: 0 0 16rpx rgba(255, 215, 0, 1);
}

/* 史诗 - 紫色 */
.particle-epic .ray {
  background: linear-gradient(to top, transparent, #a855f7, transparent);
  box-shadow: 0 0 20rpx rgba(168, 85, 247, 0.8);
}

.particle-epic .float-particle {
  background: #a855f7;
  box-shadow: 0 0 12rpx rgba(168, 85, 247, 0.8);
}

.particle-epic .sparkle {
  background: #a855f7;
  box-shadow: 0 0 16rpx rgba(168, 85, 247, 1);
}

/* 稀有 - 蓝色 */
.particle-rare .ray {
  background: linear-gradient(to top, transparent, #3b82f6, transparent);
  box-shadow: 0 0 20rpx rgba(59, 130, 246, 0.8);
}

.particle-rare .float-particle {
  background: #3b82f6;
  box-shadow: 0 0 12rpx rgba(59, 130, 246, 0.8);
}

.particle-rare .sparkle {
  background: #3b82f6;
  box-shadow: 0 0 16rpx rgba(59, 130, 246, 1);
}

/* 普通 - 灰白色 */
.particle-common .ray {
  background: linear-gradient(to top, transparent, #9ca3af, transparent);
  box-shadow: 0 0 20rpx rgba(156, 163, 175, 0.6);
}

.particle-common .float-particle {
  background: #9ca3af;
  box-shadow: 0 0 12rpx rgba(156, 163, 175, 0.6);
}

.particle-common .sparkle {
  background: #9ca3af;
  box-shadow: 0 0 16rpx rgba(156, 163, 175, 0.8);
}

/* ===== 主容器 - 只包裹内容高度 ===== */
.modal-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx 120rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 10;
}

/* ===== 顶部引言文字 ===== */
.quote-text {
  font-size: 28rpx;
  color: rgba(255,255,255,.65);
  text-align: center;
  margin-bottom: 48rpx;
  letter-spacing: 2rpx;
  opacity: 0;
  animation: fadeInUp 0.8s ease 0.2s forwards;
}

/* ===== 羽章大图区域 - 核心视觉焦点，放大展示 ===== */
.badge-image-area {
  width: 440rpx;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 40rpx;
}
.badge-main-image {
  width: 360rpx;
  height: 360rpx;
  opacity: 0;
  animation: badge-enter 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* 羽章图标入场动画 - 缩放+旋转 */
@keyframes badge-enter {
  0% {
    opacity: 0;
    transform: scale(0.3) rotate(-180deg);
  }
  60% {
    opacity: 1;
    transform: scale(1.1) rotate(10deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

/* 文字淡入向上动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 稀有度气泡 - 右上角白色圆角气泡 */
.rarity-bubble {
  position: absolute;
  top: -10rpx;
  right: -20rpx;
  background: rgba(255,255,255,.95);
  border-radius: 28rpx;
  padding: 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,.3);
  z-index: 2;
  opacity: 0;
  animation: bubble-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
}
.rarity-rate { font-size: 34rpx; font-weight: bold; color: #222; }
.rarity-label { font-size: 20rpx; color: #888; margin-top: 2rpx; }

/* 气泡弹出动画 */
@keyframes bubble-pop {
  0% {
    opacity: 0;
    transform: scale(0) translateY(20rpx);
  }
  60% {
    transform: scale(1.1) translateY(-5rpx);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* 未解锁遮罩 */
.lock-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.55);
  border-radius: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  opacity: 0;
  animation: lock-fade 0.6s ease 0.3s forwards;
}
.lock-icon { 
  font-size: 64rpx; 
  opacity: .7;
  animation: lock-shake 0.5s ease-in-out 0.9s;
}

/* 锁定遮罩淡入 */
@keyframes lock-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 锁图标晃动 */
@keyframes lock-shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-10deg); }
  75% { transform: rotate(10deg); }
}

/* ===== 羽章名称行 - 麦穗图片装饰 ===== */
.badge-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  position: relative;
  opacity: 0;
  animation: fadeInUp 0.8s ease 0.4s forwards;
}
.badge-name { font-size: 48rpx; font-weight: bold; color: #f5e6c8; letter-spacing: 4rpx; }
.badge-level { font-size: 26rpx; color: rgba(245,230,200,.6); }

/* 麦穗图片样式 */
.wheat-ear {
  width: 130rpx;
  height: 178rpx;
  flex-shrink: 0;
  opacity: 0;
}

.wheat-ear.left {
  animation: wheat-enter-left 0.8s ease 0.5s forwards;
}

.wheat-ear.right {
  animation: wheat-enter-right 0.8s ease 0.5s forwards;
}

/* 麦穗入场动画 */
@keyframes wheat-enter-left {
  from {
    opacity: 0;
    transform: translateX(-40rpx) rotate(-20deg);
  }
  to {
    opacity: 1;
    transform: translateX(0) rotate(0deg);
  }
}

@keyframes wheat-enter-right {
  from {
    opacity: 0;
    transform: translateX(40rpx) rotate(20deg);
  }
  to {
    opacity: 1;
    transform: translateX(0) rotate(0deg);
  }
}

/* ===== 描述文字 + 提示图标 ===== */
.badge-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,.45);
  text-align: center;
  margin-bottom: 4rpx;
  opacity: 0;
  animation: fadeInUp 0.8s ease 0.6s forwards;
}
.desc-hint { margin-bottom: 24rpx; opacity: 0; animation: fadeInUp 0.8s ease 0.65s forwards; }
.hint-icon { font-size: 24rpx; color: rgba(255,255,255,.25); }

/* ===== 获得时间 ===== */
.obtain-time {
  font-size: 24rpx;
  color: rgba(255,255,255,.35);
  margin-bottom: 36rpx;
  opacity: 0;
  animation: fadeInUp 0.8s ease 0.7s forwards;
}

/* ===== 奖励卡片 - 半透明深色卡片 ===== */
.reward-card {
  width: 100%;
  max-width: 620rpx;
  background: rgba(255,255,255,.07);
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,.05);
  opacity: 0;
  animation: fadeInUp 0.8s ease 0.8s forwards;
}
.reward-info { display: flex; align-items: center; gap: 24rpx; flex: 1; }
.reward-amount { font-size: 46rpx; font-weight: bold; color: #f5e6c8; }
.reward-detail { display: flex; flex-direction: column; gap: 4rpx; }
.reward-title { font-size: 26rpx; color: rgba(255,255,255,.8); }
.reward-rule { font-size: 22rpx; color: rgba(255,255,255,.4); }
.reward-expire { font-size: 22rpx; color: rgba(255,255,255,.3); }

/* 领取按钮 - 描边风格 */
.claim-btn {
  padding: 14rpx 36rpx;
  border-radius: 30rpx;
  border: 1.5rpx solid rgba(255,255,255,.25);
  background: transparent;
  transition: all 0.3s ease;
}
.claim-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}
.claim-text { font-size: 26rpx; color: rgba(255,255,255,.75); }

/* ===== 佩戴按钮 - 金色宽按钮 ===== */
.wear-btn {
  width: 500rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #f5e6c8 0%, #dcc990 100%);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 52rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(245,230,200,.2);
  opacity: 0;
  animation: fadeInUp 0.8s ease 0.9s forwards, button-glow 2s ease-in-out infinite 1.7s;
}
.wear-btn::after { display: none; }
.wear-text { font-size: 32rpx; font-weight: bold; color: #333; letter-spacing: 10rpx; }
.wear-btn:active { transform: scale(.97); opacity: .9; }

/* 按钮发光动画 */
@keyframes button-glow {
  0%, 100% {
    box-shadow: 0 8rpx 32rpx rgba(245,230,200,.2);
  }
  50% {
    box-shadow: 0 8rpx 48rpx rgba(245,230,200,.4);
  }
}

/* 已佩戴状态 - 深色描边 */
.wear-btn.wearing {
  background: transparent;
  border: 2rpx solid rgba(245,230,200,.6);
  box-shadow: none;
}
.wear-btn.wearing .wear-text { color: #f5e6c8; }

/* 未解锁提示 */
.lock-hint {
  font-size: 28rpx;
  color: rgba(255,255,255,.35);
  margin-bottom: 52rpx;
  opacity: 0;
  animation: fadeInUp 0.8s ease 0.9s forwards;
}

/* ===== 底部缩略图列表 ===== */
.thumb-list {
  width: 100%;
  white-space: nowrap;
  display: flex;
  justify-content: center;
  gap: 28rpx;
  opacity: 0;
  animation: fadeInUp 0.8s ease 1.1s forwards;
}
.thumb-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  opacity: .3;
  transition: all .25s ease;
}
.thumb-item.active { opacity: 1; transform: scale(1.08); }
.thumb-img { width: 76rpx; height: 76rpx; border-radius: 18rpx; }
.thumb-dot { width: 6rpx; height: 6rpx; border-radius: 3rpx; background: rgba(255,255,255,.2); }
.thumb-dot.active { width: 24rpx; background: #f5e6c8; }
