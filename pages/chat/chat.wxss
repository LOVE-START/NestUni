/* 微信风格聊天页面样式 */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ededed;
}

/* 聊天消息区域 */
.chat-messages {
  flex: 1;
  padding: 20rpx 0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
}

/* 欢迎区域 */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
}

/* 欢迎区域头像图片 */
.welcome-avatar {
  width: 300rpx;
  margin-bottom: 24rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 48rpx;
}

/* 快捷问题 */
.quick-questions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  width: 100%;
}

.quick-question-item {
  padding: 20rpx 32rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #555;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-question-item:active {
  opacity: 0.85;
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 消息列表 */
.message-list {
  display: flex;
  flex-direction: column;
  padding: 0 20rpx;
}

/* 时间分隔线 */
.time-divider {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}

.time-divider__text {
  font-size: 22rpx;
  color: #999;
  background: #dadada;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 消息行 - 微信风格左右布局 */
.message-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  width: 100%;
}

/* 用户消息：整体靠右对齐，头像在右侧 */
.message-row--user {
  justify-content: flex-end;
}

/* AI消息：整体靠左对齐，头像在左侧 */
.message-row--assistant {
  justify-content: flex-start;
}

/* 头像 */
.message-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

/* 用户头像：绿色背景，右侧间距 */
.message-avatar--user {
  background: #07c160;
  margin-left: 16rpx;
}

/* AI头像：白色背景，左侧间距 */
.message-avatar--assistant {
  background: #fff;
  margin-right: 16rpx;
  border: 1rpx solid #e5e5e5;
}

/* 头像图片样式 */
.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.avatar-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

.message-avatar--assistant .avatar-text {
  font-size: 40rpx;
}

/* 消息内容区域 */
.message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.message-row--user .message-content {
  align-items: flex-end;
}

.message-row--assistant .message-content {
  align-items: flex-start;
}

/* 带 Agent 信息块的消息 - 气泡、步骤条、确认卡片统一撑满内容区宽度，
   避免三者各自按内容收缩导致右边缘参差不齐 */
.message-content--agent > .message-bubble,
.message-content--agent > agent-steps,
.message-content--agent > agent-confirm-card {
  align-self: stretch;
}

/* 消息气泡 - 毛玻璃效果 */
.message-bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
  position: relative;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

/* 用户消息气泡 - 渐变背景 + 毛玻璃效果 */
.message-bubble--user {
  color: #fff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* AI消息气泡 - 白色毛玻璃效果 */
.message-bubble--assistant {
  background: rgba(255, 255, 255, 0.85);
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 错误消息样式 - 红色毛玻璃效果 */
.message-bubble--error {
  background: rgba(255, 77, 79, 0.12);
  color: #ff4d4f;
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.message-text {
  font-size: 30rpx;
  line-height: 1.5;
}

.message-text--user {
  color: #fff;
}

/* 加载动画 */
.loading-dots {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #b2b2b2;
  animation: dotPulse 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
.dot:nth-child(3) { animation-delay: 0s; }

@keyframes dotPulse {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 输入区域 - 悬浮底部透明样式 */
.chat-input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: transparent;
  flex-shrink: 0;
  z-index: 100;
}

.input-wrapper {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 16rpx 20rpx;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(20rpx);
}

.chat-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 160rpx;
  padding: 14rpx 24rpx;
  background: transparent;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #333;
  border: none;
  transition: all 0.25s ease;
}

.chat-input:focus {
  background: rgba(7, 193, 96, 0.06);
}

/* 发送按钮 - 圆形设计带点击效果 */
.send-btn {
  min-width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.08);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
  box-shadow: none;
}

.send-btn--active {
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

/* 发送按钮点击效果 - 缩放 + 透明度 */
.send-btn:active {
  transform: scale(0.92);
  opacity: 0.85;
}

.send-btn--active:active {
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 发送按钮图标 */
.send-btn__icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
  transition: all 0.2s ease;
}

.send-btn--active .send-btn__icon {
  opacity: 1;
}

/* 输入框禁用状态 */
.chat-input[disabled] {
  opacity: 0.6;
}

/* 安全区域底部留白 */
.input-safe-bottom {
  height: env(safe-area-inset-bottom);
  min-height: 12rpx;
}

.scroll-bottom-anchor {
  height: 40rpx;
}

/* 推荐卡片容器 - 突破消息气泡70%宽度限制，占满屏幕宽度 */
.recommendation-cards {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100vw;
  margin-left: 50%;
  transform: translateX(-50%);
}

/* 推荐卡片基础样式 */
.recommendation-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.recommendation-card:active {
  transform: scale(0.98);
}

/* 活动卡片 - 全新图片主导样式（swiper横向滑动） */
.event-swiper-container {
  position: relative;
  width: 100%;
}

.event-swiper {
  width: 100%;
  height: 520rpx;
}

/* 活动卡片 - swiper item 添加间距 */
.event-swiper-item {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 16rpx;
  box-sizing: border-box;
}

/* 新活动卡片 - 图片占满 + 底部信息叠加 */
.event-card-new {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.18);
}

/* 卡片封面图 - 占满整个卡片 */
.event-card__cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 底部渐变遮罩层 */
.event-card__overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 28rpx 28rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.35) 60%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 140rpx;

}

/* 活动标题 */
.event-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 底部：logo + 社团名 */
.event-card__footer {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.event-card__logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.event-card__club-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 页码指示器 */
.event-swiper-indicator {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.event-swiper-indicator text {
  font-size: 22rpx;
  color: #999;
  background: rgba(0, 0, 0, 0.06);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

