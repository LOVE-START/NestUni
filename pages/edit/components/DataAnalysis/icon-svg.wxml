<!-- 
  SVG 图标组件
  @description 使用 image 标签加载 base64 编码的 SVG 图标
  @param {string} name - 图标名称
  @param {string} size - 图标大小: xs, sm, md, lg
  @param {string} color - 图标颜色: white, primary (默认 primary)
-->
<template name="icon-svg">
  <view class="icon-wrapper icon-size-{{size || 'md'}}">
    
    <!-- ========== 白色图标 ========== -->
    
    <!-- 数据概览图标 - 白色 -->
    <image wx:if="{{name === 'chart-bar' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 趋势上升图标 - 白色 -->
    <image wx:elif="{{name === 'trend-up' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 趋势下降图标 - 白色 -->
    <image wx:elif="{{name === 'trend-down' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 日历图标 - 白色 -->
    <image wx:elif="{{name === 'calendar' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 活动图标 - 白色 -->
    <image wx:elif="{{name === 'activity' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMjIgMTJIMThMMTUgMjFMOSAzTDYgMTJIMiIgc3Ryb2tlPSIjZmZmZmZmIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIvPjwvc3ZnPg==" mode="aspectFit"></image>
    
    <!-- 用户图标 - 白色 -->
    <image wx:elif="{{name === 'users' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 招新图标 - 白色 -->
    <image wx:elif="{{name === 'user-plus' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 星星图标 - 白色 -->
    <image wx:elif="{{name === 'star' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 图表折线图标 - 白色 -->
    <image wx:elif="{{name === 'chart-line' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 饼图图标 - 白色 -->
    <image wx:elif="{{name === 'chart-pie' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 漏斗图标 - 白色 -->
    <image wx:elif="{{name === 'funnel' && color === 'white'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- ========== 主题色图标（默认） ========== -->
    
    <!-- 数据概览图标 - 主题色 -->
    <image wx:elif="{{name === 'chart-bar'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 趋势上升图标 - 主题色 -->
    <image wx:elif="{{name === 'trend-up'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 趋势下降图标 - 主题色 -->
    <image wx:elif="{{name === 'trend-down'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 日历图标 - 主题色 -->
    <image wx:elif="{{name === 'calendar'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 活动图标 - 主题色 -->
    <image wx:elif="{{name === 'activity'}}" class="icon-image" src="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMjIgMTJIMThMMTUgMjFMOSAzTDYgMTJIMiIgc3Ryb2tlPSIjM2I4MmY2IiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIvPjwvc3ZnPg==" mode="aspectFit"></image>
    
    <!-- 用户图标 - 主题色 -->
    <image wx:elif="{{name === 'users'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 招新图标 - 主题色 -->
    <image wx:elif="{{name === 'user-plus'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 星星图标 - 主题色 -->
    <image wx:elif="{{name === 'star'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 图表折线图标 - 主题色 -->
    <image wx:elif="{{name === 'chart-line'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 饼图图标 - 主题色 -->
    <image wx:elif="{{name === 'chart-pie'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
    
    <!-- 漏斗图标 - 主题色 -->
    <image wx:elif="{{name === 'funnel'}}" class="icon-image" src="data:image/svg+xml;base64," mode="aspectFit"></image>
  </view>
</template>
