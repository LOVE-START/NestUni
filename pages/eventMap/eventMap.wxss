/* 活动地图页面样式 */

.event-map-page {
  min-height: 100vh;
  background: #f6f7fb;
}

/* 地图容器 */
.map-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* 定位按钮 */
.location-btn {
  position: absolute;
  right: 30rpx;
  bottom: 200rpx;
  width: 80rpx;
  height: 80rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.location-icon {
  font-size: 40rpx;
}

/* 图例 */
.legend {
  position: absolute;
  left: 30rpx;
  bottom: 200rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #7a808a;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.ongoing {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

/* 图例 - 即将开始使用黄色 */
.legend-dot.upcoming {
  background: #ffd66f;
}

/* 导航状态显示 */
.navigation-status {
  position: absolute;
  top: 120rpx;
  left: 30rpx;
  right: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(8px);
  z-index: 10;
  cursor: pointer;
  transition: all 0.3s ease;
}

.navigation-status:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.nav-status-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.nav-status-icon {
  font-size: 48rpx;
}

.nav-status-info {
  flex: 1;
}

.nav-status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2430;
  margin-bottom: 8rpx;
}

.nav-status-detail {
  font-size: 26rpx;
  color: #5a6068;
}

/* 活动卡片弹窗 - 票根风格 */
.event-card {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.event-card.show {
  opacity: 1;
  visibility: visible;
}

.event-card-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.event-card-content {
  position: relative;
  width: 100%;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  margin-bottom: 10rpx; /* 整体上移，与底部保持距离 */
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.event-card.show .event-card-content {
  transform: translateY(0);
}

.event-ticket {
  background: #ffffff;
  border-radius: 45rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.ticket-cover {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
  border-radius: 45rpx;
  object-fit: cover;
}

.ticket-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #ffffff;
  border-radius: 20rpx;
  backdrop-filter: blur(8rpx);
}

.ticket-status.ongoing {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

/* 票根状态标签 - 即将开始使用黄色 */
.ticket-status.upcoming {
  background: #ffd66f;
}

.ticket-divider {
  position: relative;
  height: 0;
  background: #ffffff;
}

.divider-line {
  border-top: 2rpx dashed #e8e8e8;
  margin: 0 40rpx;
}

.divider-circle {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  background: #f6f7fb;
  border-radius: 50%;
  top: 50%;
  transform: translateY(-50%);
}

.divider-circle.left {
  left: -16rpx;
}

.divider-circle.right {
  right: -16rpx;
}

.ticket-info {
  padding: 28rpx 32rpx 32rpx;
  background: #ffffff;
}

.ticket-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2430;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.ticket-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-icon {
  width: 48rpx;
  height: 48rpx;
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.detail-text {
  font-size: 28rpx;
  color: #5a6068;
  flex: 1;
}

.close-btn {
  position: absolute;
  top: 44rpx;
  left: 56rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
  z-index: 10;
}

.close-icon {
  color: #ffffff;
  font-size: 36rpx;
  line-height: 1;
}

/* 附近活动推荐 */
.nearby-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 50;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2430;
}

/* 展开/收起箭头按钮 */
.section-more {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 箭头图标 - 使用CSS绘制 */
.arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid #ffafbd;
  border-bottom: 4rpx solid #ffafbd;
  transition: transform 0.3s ease;
  margin-bottom: 8rpx; /* 上移箭头 */
}

/* 箭头向下 */
.arrow-icon.arrow-down {
  transform: rotate(45deg);
}

/* 箭头向上 */
.arrow-icon.arrow-up {
  transform: rotate(-135deg);
}

.nearby-scroll {
  white-space: nowrap;
}

.nearby-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx;
}

.nearby-item {
  width: 260rpx;
  background: #f6f7fb;
  border-radius: 16rpx;
  overflow: hidden;
}

.nearby-cover {
  width: 100%;
  height: 140rpx;
}

.nearby-info {
  padding: 16rpx;
}

.nearby-title {
  font-size: 26rpx;
  color: #1f2430;
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nearby-distance {
  font-size: 22rpx;
  color: #7a808a;
  margin-bottom: 8rpx;
}

.nearby-status {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #ffffff;
  border-radius: 10rpx;
}

.nearby-status.ongoing {
  background-image: var(--decoration-bg, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
}

/* 附近活动状态 - 即将开始使用黄色 */
.nearby-status.upcoming {
  background: #ffd66f;
}

/* 空状态 */
.empty-state {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #7a808a;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #b0b5bd;
}

/* 加载状态 */
.loading-state {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  z-index: 10;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #edf0f5;
  border-top-color: #ffafbd;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 操作按钮区域 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.nav-btn {
  background-image: var(--decoration-bg-button, linear-gradient(to right, rgb(255, 175, 189), rgb(255, 195, 160)));
  color: #ffffff;
}

/* 全宽按钮 */
.action-btn.full-width {
  width: 100%;
}

.action-icon {
  font-size: 32rpx;
}

.action-text {
  font-size: 28rpx;
}
