/* 优雅的悬浮底部导航栏样式 */
.floating-bottom-bar {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 92%;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  border-radius: 55rpx;
  box-shadow: 
    0 8rpx 20rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04),
    0 -1rpx 0 rgba(255, 255, 255, 0.6) inset;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  z-index: 999;
  backdrop-filter: blur(10rpx);
  padding: 0 10rpx;
}

.tab-bar-item {
  flex: 1;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
}

.icon-container {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.icon {
  width: 48rpx;
  height: 48rpx;
  transition: all 0.3s ease;
  position: relative;
  z-index: 5;
}

.icon-background {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-gradient, linear-gradient(to right, rgb(253, 224, 150), rgb(251, 191, 36)));
  opacity: 0.15;
  z-index: 1;
  box-shadow: 0 0 10rpx 2rpx rgba(31, 27, 23, 0.3);
}

.label {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  margin-top: 8rpx;
  z-index: 5;
  transition: all 0.3s ease;
  color: #666666;
}

.tab-bar-item.active {
  transform: translateY(0); /* 移除上移效果，保持简洁 */
}

.tab-bar-item.active .icon {
  transform: scale(1); /* 移除缩放效果，保持简洁 */
}

.tab-bar-item.active .label {
  font-weight: 600;
  color: var(--primary-color, #1f1b17);
}

.tab-bar-item:active {
  transform: scale(0.92);
  transition: all 0.1s ease;
}