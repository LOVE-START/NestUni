<theme-provider id="themeProvider" bind:themeChange="onThemeChange">
  <view wx:if="{{permissionChecked && !hasPermission}}" class="no-permission-page">
  </view>

  <view wx:elif="{{permissionChecked && hasPermission}}" class="applications-page">
    <!-- 顶部装饰背景 -->
    <view class="header-decoration" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg)">
      <view class="header-pattern"></view>
    </view>
    
    <!-- 自定义导航栏 -->
    <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-content">
        <view class="nav-left" bindtap="goBack">
          <image class="nav-back-icon" src="/images/back.png" mode="aspectFit" />
        </view>
        <view class="nav-title">{{recruitmentTitle || '报名管理'}}</view>
        <view class="nav-right"></view>
      </view>
    </view>

    <!-- 统计概览卡片 -->
    <view class="stats-card">
      <view class="stats-header">
        <view class="stats-title">
          <text class="stats-title-text">报名概览</text>
          <text class="stats-subtitle">Registration Overview</text>
        </view>
        <view class="stats-icon-wrap" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg)">
          <image class="stats-icon" src="/images/summary.png" mode="aspectFit" />
        </view>
      </view>
      
      <view class="stats-grid">
        <view class="stat-item">
          <view class="stat-number" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg); -webkit-background-clip: text; background-clip: text; color: transparent;">{{stats.total}}</view>
          <view class="stat-label">总报名</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <view class="stat-number" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg); -webkit-background-clip: text; background-clip: text; color: transparent;">{{stats.pending}}</view>
          <view class="stat-label">待处理</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <view class="stat-number" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg); -webkit-background-clip: text; background-clip: text; color: transparent;">{{stats.accepted}}</view>
          <view class="stat-label">已录取</view>
        </view>
      </view>
    </view>

    <!-- 状态筛选 -->
    <view class="filter-section">
      <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
        <view class="filter-tabs">
          <view 
            class="filter-tab {{currentStatus === 'all' ? 'active' : ''}}" 
            style="--decoration-bg: {{theme.gradient}}"
            bindtap="onStatusChange" 
            data-status="all"
          >
            <text class="tab-text">全部</text>
            <text class="tab-count" wx:if="{{stats.total > 0}}">{{stats.total}}</text>
          </view>
          <view 
            class="filter-tab {{currentStatus === 'submitted' ? 'active' : ''}}" 
            style="--decoration-bg: {{theme.gradient}}"
            bindtap="onStatusChange" 
            data-status="submitted"
          >
            <text class="tab-text">待处理</text>
            <text class="tab-count" wx:if="{{stats.pending > 0}}">{{stats.pending}}</text>
          </view>
          <view 
            class="filter-tab {{currentStatus === 'viewed' ? 'active' : ''}}" 
            style="--decoration-bg: {{theme.gradient}}"
            bindtap="onStatusChange" 
            data-status="viewed"
          >
            <text class="tab-text">已查看</text>
          </view>
          <view 
            class="filter-tab {{currentStatus === 'interviewing' ? 'active' : ''}}" 
            style="--decoration-bg: {{theme.gradient}}"
            bindtap="onStatusChange" 
            data-status="interviewing"
          >
            <text class="tab-text">面试中</text>
          </view>
          <view 
            class="filter-tab {{currentStatus === 'accepted' ? 'active' : ''}}" 
            style="--decoration-bg: {{theme.gradient}}"
            bindtap="onStatusChange" 
            data-status="accepted"
          >
            <text class="tab-text">已录取</text>
          </view>
          <view 
            class="filter-tab {{currentStatus === 'rejected' ? 'active' : ''}}" 
            style="--decoration-bg: {{theme.gradient}}"
            bindtap="onStatusChange" 
            data-status="rejected"
          >
            <text class="tab-text">已拒绝</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 报名列表 -->
    <scroll-view 
      scroll-y 
      class="application-list"
      bindscrolltolower="loadMore"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onPullDownRefresh"
    >
      <view class="list-content">
        <!-- 报名卡片 -->
        <view 
          class="application-card" 
          wx:for="{{applications}}" 
          wx:key="id"
          bindtap="goToDetail"
          data-id="{{item.id}}"
        >
          <!-- 左侧状态指示条 -->
          <view class="card-status-bar {{item.statusClass}}"></view>
          
          <!-- 卡片主体 -->
          <view class="card-body">
            <!-- 头像区域 -->
            <view class="avatar-section">
              <image class="applicant-avatar" src="{{item.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
              <view class="status-badge {{item.statusClass}}" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg)">
                {{item.statusText}}
              </view>
            </view>
            
            <!-- 信息区域 -->
            <view class="info-section">
              <view class="applicant-name">{{item.form_data.name || item.nickname || '未填写姓名'}}</view>
              
              <view class="info-row">
                <view class="info-tags">
                  <view class="info-tag" wx:if="{{item.student_id}}">
                    <text class="tag-emoji">🎓</text>
                    <text>{{item.student_id}}</text>
                  </view>
                  <view class="info-tag" wx:if="{{item.form_data.major}}">
                    <text class="tag-emoji">📚</text>
                    <text>{{item.form_data.major}}</text>
                  </view>
                </view>
                
                <!-- 箭头 -->
                <view class="arrow-indicator">
                  <text class="arrow-text">›</text>
                </view>
              </view>
              
              <view class="submit-time">
                <text class="time-emoji">🕐</text>
                <text>{{item.submitted_at}}</text>
              </view>
            </view>
          </view>
          
          <!-- 快捷联系方式 -->
          <view class="contact-bar" wx:if="{{item.wechat || item.form_data.contact || item.form_data.phone}}" catchtap="copyText" data-text="{{item.wechat || item.form_data.contact || item.form_data.phone}}" data-label="联系方式">
            <view class="contact-left">
              <view class="contact-icon-wrap" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg)">
                <image class="contact-icon" src="/images/phone1.png" mode="aspectFit" />
              </view>
              <text class="contact-value">{{item.wechat || item.form_data.contact || item.form_data.phone}}</text>
            </view>
            <view class="copy-btn" style="--decoration-bg: {{theme.gradient}}; background-image: var(--decoration-bg)">
              <text>copy</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{applications.length > 0}}">
        <view wx:if="{{loading}}" class="loading-wrap">
          <view class="loading-spinner"></view>
          <text class="loading-text">加载中...</text>
        </view>
        <view wx:elif="{{!hasMore}}" class="no-more">
          <view class="no-more-line"></view>
          <text class="no-more-text">-End-</text>
          <view class="no-more-line"></view>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!applications.length && !loading}}">
        <image class="empty-image" src="/images/default-avatar.png" mode="aspectFit" />
        <text class="empty-title">暂无报名记录</text>
        <text class="empty-desc">还没有收到任何报名申请</text>
      </view>
    </scroll-view>
  </view>
</theme-provider>
