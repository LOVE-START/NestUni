/* 🌈 票卡容器（最外层） */
.clubs-events-card-wrapper {
  width: 100%;
  min-height: 900rpx;        /* 保证最小高度 */
  max-width: 600rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}

/* 🎟️ 卡片主容器 */
.clubs-events-card {
  width: 100%;
  max-width: 580rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.08), 0 4rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  overflow: visible;          /* 修改为visible以避免裁剪内容 */
  position: relative;
  transition: all 0.35s ease;
  margin: 0 auto;
  padding: 10rpx;            /* 添加padding以容纳缩放效果 */
  box-sizing: border-box;
}

/* 半透明覆盖层，仅覆盖封面 */
.clubs-events-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 380rpx;          
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10rpx);
  z-index: 1;
  border-radius: 28rpx 28rpx 0 0;
}

/* 卡片悬浮效果 */
.clubs-events-card:hover {
  transform: translateY(-10rpx);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.12);
}

/* 封面图片 */
.cover {
  width: 100%;
  height: 380rpx;
  object-fit: cover;
  filter: brightness(0.97);
  z-index: 1;
  position: relative;
  border-radius: 28rpx 28rpx 0 0;
  transition: all 0.3s ease;
  transform-origin: center center; /* 设置变换原点 */
}

/* 添加波纹效果容器 */
.ripple-container {
  position: relative;
  overflow: visible; /* 修改为visible以避免裁剪内容 */
  border-radius: 28rpx 28rpx 0 0;
  margin: -10rpx -10rpx 0 -10rpx; /* 补偿父容器的padding */
}

/* 波纹效果 */
.ripple {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  transform: scale(0);
  animation: ripple 0.6s linear;
  pointer-events: none;
}

@keyframes ripple {
  to {
    transform: scale(2.5);
    opacity: 0;
  }
}

.card-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a1d29;
  line-height: 1.3;
}
/* 位置信息 */
.location {
  color: #6b7280;
  font-size: 26rpx;
  margin-top: -10rpx;
  margin-bottom: 10rpx;
  text-align: left;
  z-index: 2;
  position: relative;
}
/* 主体内容 */
.content {
  padding: 28rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;               /* 项目间距 */
  z-index: 2;
  position: relative;
}

/* 标签页 */
.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tab {
  font-size: 28rpx;
  color: #9ca3af;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(243, 244, 246, 0.5);
  transition: all 0.3s ease;
}

.tab.active {
  color: #111827;
  font-weight: 700;
  background: rgba(59, 130, 246, 0.1);
}

/* 列表容器 */
.list-container {
  max-height: 500rpx;       /* 提高滚动区域高度，让列表显示更多内容 */
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16rpx;               /* 增加列表项间距 */
  padding-right: 8rpx;
}

/* 隐藏滚动条 */
.list-container::-webkit-scrollbar {
  display: none;
}

/* 列表项 */
.item {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;    /* 高度更大 */
  border-radius: 20rpx;     /* 更圆润 */
  background: rgba(243, 244, 246, 0.5);
  gap: 16rpx;               /* 图标和文字间距加大 */
}

/* 图标尺寸 */
.item-icon {
  width: 90rpx;             /* 宽更大 */
  height: 90rpx;            /* 高更大 */
  border-radius: 16rpx;     /* 圆角同步增加 */
  object-fit: cover;
}

/* 文字内容容器 */
.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;              /* 标题和描述之间的间距 */
}

/* 标题 */
.item-title {
  font-size: 28rpx;         /* 字号略大 */
  font-weight: 600;
  color: #1a1d29;
  line-height: 1.4;         /* 行高调整 */
}

/* 描述信息容器 */
.item-desc-container {
  display: flex;
  flex-direction: column;
  gap: 4rpx;              /* 日期和时间之间的间距 */
}

/* 描述文字 */
.item-desc {
  font-size: 24rpx;         /* 字号略大 */
  color: #6b7280;
  line-height: 1.3;
}

/* 时间信息 */
.item-time {
  font-size: 22rpx;
  color: #4b5563;
  font-weight: 500;
}

/* 角色和状态标签容器 */
.role-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

/* 角色和状态标签 */
.item-role, .item-status {
  font-size: 22rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  align-self: flex-start;
  font-weight: 600;
  position: relative;
  overflow: hidden;
  z-index: 1;
  height: auto;
  line-height: 1.4;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 会长标签样式 - 浅金色渐变，精致感 */
.item-role.leader {
  background: linear-gradient(135deg, #fde68a 0%, #fdd75b 100%);
  color: #92400e;
}

/* 管理员标签样式 - 粉色和金色渐变 */
.item-role.admin {
  background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
}

/* 成员标签样式 - 蓝粉色和金色渐变 */
.item-role.member {
  background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
  color: #1e40af;
}

/* 活动状态标签样式 */
.item-status {
  font-size: 22rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  align-self: flex-start;
  font-weight: 600;
  position: relative;
  overflow: hidden;
  z-index: 1;
  height: auto;
  line-height: 1.4;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  color: #ffffff;
}

/* 已加入状态 - 绿色渐变 */
.item-status.joined {
background: linear-gradient(135deg, rgb(255, 183, 197) 0%, rgb(255, 220, 200) 100%);
}

/* 待确认状态 - 橙色渐变 */
.item-status.pending {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 20rpx 0;
  color: #9ca3af;
  font-size: 24rpx;
}

/* ⚡锯齿分隔线 */
.zigzag {
  height: 12rpx;
  background: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 8rpx,
    #e5e7eb 8rpx,
    #e5e7eb 16rpx
  );
  margin: -2rpx 0;
}

/* 底部信息区域 */
.bottom {
  width: 100%;
  border-radius: 0 0 28rpx 28rpx;
  padding: 28rpx 32rpx;         /* 内边距加大 */
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 0 rgba(0,0,0,0.08); /* 上边微小分隔线加深 */
  z-index: 2;
  position: relative;
}

/* 数据块容器 */
.bottom .code-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
  gap: 28rpx;                    /* 数据块间距加大 */
}

/* 单个数据块 */
.bottom .code {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;                     /* label 与 value 间距增加 */
}

/* 标签文字 */
.bottom .label {
  font-size: 26rpx;               /* 放大文字 */
  color: #9ca3af;
  font-weight: 500;
}

/* 值文字 */
.bottom .value {
  font-size: 34rpx;               /* 放大数值 */
  font-weight: 700;
  color: #1a1d29;
}